{
  "segments": [
    { "id": "s1", "text": "밤하늘에서 유난히 빨간 점 하나가 보여요.", "gap_before": 1.2 },
    { "id": "s2", "text": "바로 화성이에요.", "gap_before": 0.3 },
    { "id": "s3", "text": "달은 회색인데 화성만 유독 빨개요.", "gap_before": 0.5 },
    { "id": "s4", "text": "화성 흙과 돌엔 철분이 많이 섞여 있어요.", "gap_before": 1.0 },
    { "id": "s5", "text": "오랜 시간 산소를 만나 녹슬듯 산화철로 변해요.", "gap_before": 0.4 },
    { "id": "s6", "text": "산화철은 빨간빛을 유독 많이 반사해요.", "gap_before": 0.4 },
    { "id": "s7", "text": "그래서 표면 전체가 빨갛게 보이는 거예요.", "gap_before": 0.4 },
    { "id": "s8", "text": "먼지 폭풍이 불면 하늘까지 붉어져요.", "gap_before": 0.6 },
    { "id": "s9", "text": "산화철로 뒤덮인 표면이 화성을 빨갛게 만들어요.", "gap_before": 0.6 }
  ]
}
