{
  "segments": [
    { "id": "s1", "text": "탈수가 시작되자 세탁기가 덜덜 떨려요.", "gap_before": 1.0, "emph": ["덜덜"] },
    { "id": "s2", "text": "빨래가 많아서만 떨리는 게 아니에요.", "gap_before": 0.7, "emph": ["많아서만", "아니에요"] },
    { "id": "s3", "text": "고르게 퍼진 통은 덜, 쏠린 통은 크게 떨려요.", "gap_before": 0.7, "emph": ["쏠린", "크게"] },
    { "id": "s4", "text": "통이 빠르게 돌면 빨래는 곧게 날아가려 해요.", "gap_before": 0.9, "emph": ["곧게"] },
    { "id": "s5", "text": "그래서 빨래는 벽에 눌리고 벽을 되밀어요.", "gap_before": 0.7, "emph": ["눌리고", "되밀어요"] },
    { "id": "s6", "text": "빨래가 한쪽에 뭉치면 그쪽이 더 무거워요.", "gap_before": 0.7, "emph": ["한쪽에", "무거워요"] },
    { "id": "s7", "text": "이 덩어리는 반대쪽이 없어서 통을 한쪽으로 밀어요.", "gap_before": 0.7, "emph": ["반대쪽이", "한쪽으로"] },
    { "id": "s8", "text": "덩어리가 도니까 미는 방향도 계속 바뀌어요.", "gap_before": 0.7, "emph": ["방향도", "바뀌어요"] },
    { "id": "s9", "text": "그래서 통이 이쪽저쪽 흔들려 덜덜 떨려요.", "gap_before": 0.7, "emph": ["이쪽저쪽", "덜덜"] },
    { "id": "s10", "text": "탈수 때 세탁기가 떨리는 건 빨래가 한쪽에 쏠려서예요.", "gap_before": 0.9, "emph": ["한쪽에", "쏠려서예요"] }
  ]
}
