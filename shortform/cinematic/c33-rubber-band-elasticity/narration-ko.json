{
  "segments": [
    { "id": "s1", "text": "고무줄을 쭉 당겼다가 놓아요.", "gap_before": 1.2 },
    { "id": "s2", "text": "금방 원래 길이로 돌아와요.", "gap_before": 0.4 },
    { "id": "s3", "text": "찰흙은 늘어나면 그대로 있지만", "gap_before": 0.5 },
    { "id": "s4", "text": "고무줄은 자꾸 줄어들려고 해요.", "gap_before": 0.35 },
    { "id": "s5", "text": "가늘고 긴 실 같은 분자가 가득해요.", "gap_before": 0.8 },
    { "id": "s6", "text": "평소엔 실타래처럼 헝클어져 있어요.", "gap_before": 0.35 },
    { "id": "s7", "text": "당기면 이 실들이 쭉 펴져요.", "gap_before": 0.35 },
    { "id": "s8", "text": "놓으면 실들이 다시 헝클어지려 해요.", "gap_before": 0.35 },
    { "id": "s9", "text": "그 실들이 다시 뭉치는 거예요.", "gap_before": 0.5 },
    { "id": "s10", "text": "그래서 고무줄이 다시 줄어들어요.", "gap_before": 0.35 }
  ]
}
