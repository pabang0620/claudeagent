{
  "segments": [
    { "id": "s1", "text": "모기 한 마리가 팔에 앉았어요.", "gap_before": 1.2 },
    { "id": "s2", "text": "그 자리가 금세 가려워졌어요.", "gap_before": 0.5 },
    { "id": "s3", "text": "근데 이 가려움, 모기가 만든 게 아니에요.", "gap_before": 0.5 },
    { "id": "s4", "text": "물린 자리 속으로 들어가볼게요.", "gap_before": 0.6 },
    { "id": "s5", "text": "모기는 피가 굳지 않게 침을 넣거든요.", "gap_before": 0.5 },
    { "id": "s6", "text": "이 성분을 몸은 낯선 침입자로 봐요.", "gap_before": 0.4 },
    { "id": "s7", "text": "몸이 막으려고 방어 물질을 내보내요.", "gap_before": 0.4 },
    { "id": "s8", "text": "그 물질이 혈관을 넓히고 신경을 건드려요.", "gap_before": 0.4 },
    { "id": "s9", "text": "그래서 물린 자리가 붓고 가려운 거예요.", "gap_before": 0.5 },
    { "id": "s10", "text": "긁으면 그 물질이 퍼져서 더 가려워질 수 있어요.", "gap_before": 0.5 }
  ]
}
