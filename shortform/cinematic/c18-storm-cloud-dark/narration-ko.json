{
  "segments": [
    { "id": "s1", "text": "뭉게구름은 새하얀데", "gap_before": 1.3 },
    { "id": "s2", "text": "비구름만 새까매요", "gap_before": 0.4 },
    { "id": "s3", "text": "근데 물방울은 둘 다 투명해요", "gap_before": 0.6 },
    { "id": "s4", "text": "물방울은 햇빛 색을 그대로 흩뿌려요", "gap_before": 0.9 },
    { "id": "s5", "text": "그래서 원래 구름은 하얗게 보여요", "gap_before": 0.3 },
    { "id": "s6", "text": "비구름은 물방울이 훨씬 빽빽해요", "gap_before": 0.5 },
    { "id": "s7", "text": "구름 두께도 몇 배나 두껍고요", "gap_before": 0.3 },
    { "id": "s8", "text": "햇빛이 내려오다 물방울에 자꾸 부딪혀서", "gap_before": 0.5 },
    { "id": "s9", "text": "빛 상당수가 다시 위로 흩어져요", "gap_before": 0.3 },
    { "id": "s10", "text": "그만큼 바닥까지 오는 빛이 줄어들고", "gap_before": 0.4 },
    { "id": "s11", "text": "그래서 비구름 아래가 캄캄해 보여요", "gap_before": 0.3 },
    { "id": "s12", "text": "물방울이 달라서가 아니라 두껍고 빽빽해서 어두워요", "gap_before": 0.6 }
  ]
}
