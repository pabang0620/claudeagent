{
  "segments": [
    { "id": "s1", "text": "물에 설탕을 넣고 기다리면 알갱이가 사라져요.", "gap_before": 1.0, "emph": ["기다리면", "사라져요"] },
    { "id": "s2", "text": "설탕이 없어진 게 아니에요.", "gap_before": 1.0, "emph": ["아니에요"] },
    { "id": "s3", "text": "알갱이는 아주 작은 설탕 분자가 뭉친 거예요.", "gap_before": 1.4, "emph": ["분자가", "뭉친"] },
    { "id": "s4", "text": "물 분자는 쉬지 않고 알갱이에 부딪혀요.", "gap_before": 0.8, "emph": ["쉬지", "부딪혀요"] },
    { "id": "s5", "text": "설탕 분자는 물 분자에 끌려서 떨어져 나와요.", "gap_before": 0.7, "emph": ["끌려서", "떨어져"] },
    { "id": "s6", "text": "떨어진 설탕 분자는 물속으로 퍼져 나가요.", "gap_before": 0.7, "emph": ["퍼져", "나가요"] },
    { "id": "s7", "text": "분자 하나하나는 너무 작아서 눈에 안 보여요.", "gap_before": 0.7, "emph": ["너무", "안"] },
    { "id": "s8", "text": "그래서 투명한 물인데도 달아요.", "gap_before": 1.0, "emph": ["투명한", "달아요"] },
    { "id": "s9", "text": "설탕은 분자로 흩어진 채 물속에 남아 있어요.", "gap_before": 0.8, "emph": ["흩어진", "남아"] }
  ]
}
