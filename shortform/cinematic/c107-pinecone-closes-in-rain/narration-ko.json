{
  "segments": [
    { "id": "s1", "text": "활짝 열린 솔방울에 비가 내려요.", "gap_before": 1.0, "emph": ["활짝", "비가"] },
    { "id": "s2", "text": "솔방울이 비늘을 오므려 닫아요.", "gap_before": 0.8, "emph": ["오므려"] },
    { "id": "s3", "text": "솔방울이 스스로 움직이는 게 아니에요.", "gap_before": 0.7, "emph": ["스스로"] },
    { "id": "s4", "text": "비늘 한 장은 두 겹이 붙어 있어요.", "gap_before": 0.9, "emph": ["겹이"] },
    { "id": "s5", "text": "두 겹은 섬유 방향이 달라 부푸는 양이 달라요.", "gap_before": 0.7, "emph": ["방향이", "양이"] },
    { "id": "s6", "text": "두 겹이 물을 먹고, 바깥 겹이 더 부풀어요.", "gap_before": 0.7, "emph": ["바깥", "부풀어요"] },
    { "id": "s7", "text": "바깥 겹이 더 길어지니 비늘이 안쪽으로 휘어요.", "gap_before": 0.7, "emph": ["길어지니", "안쪽으로"] },
    { "id": "s8", "text": "비늘이 모두 휘면 솔방울이 닫혀요.", "gap_before": 0.7, "emph": ["모두", "닫혀요"] },
    { "id": "s9", "text": "솔방울 비늘은 젖으면 안으로 휘고 마르면 펴져요.", "gap_before": 0.9, "emph": ["젖으면", "마르면"] }
  ]
}
