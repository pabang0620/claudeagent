{
  "segments": [
    { "id": "s1", "text": "꽁꽁 언 길바닥에 소금을 뿌려요.", "gap_before": 1.2 },
    { "id": "s2", "text": "근데 날씨가 따뜻해진 건 아니에요.", "gap_before": 0.6 },
    { "id": "s3", "text": "얼음 표면엔 원래 얇은 물기가 있어요.", "gap_before": 0.7 },
    { "id": "s4", "text": "소금이 그 물기에 녹아 소금물이 돼요.", "gap_before": 0.4 },
    { "id": "s5", "text": "소금물은 어는점이 훨씬 더 낮아요.", "gap_before": 0.4 },
    { "id": "s6", "text": "그래서 지금 온도로는 얼 수가 없어요.", "gap_before": 0.4 },
    { "id": "s7", "text": "그 소금물이 옆 얼음까지 계속 녹여요.", "gap_before": 0.6 },
    { "id": "s8", "text": "어는점이 낮아진 소금물이라 계속 녹는 거예요.", "gap_before": 0.5 }
  ]
}
