{
  "segments": [
    { "id": "s1", "text": "돋보기로 햇빛을 종이에 모으면 작은 점이 타요.", "gap_before": 1.0, "emph": ["모으면", "타요."] },
    { "id": "s2", "text": "돋보기가 열을 만들어 태우는 게 아니에요.", "gap_before": 0.7, "emph": ["아니에요."] },
    { "id": "s3", "text": "돋보기는 햇빛이 가는 길을 바꿀 뿐이에요.", "gap_before": 0.7, "emph": ["길을", "바꿀"] },
    { "id": "s4", "text": "나란히 온 햇빛은 유리에 들어가면 느려져 꺾여요.", "gap_before": 0.8, "emph": ["느려져", "꺾여요."] },
    { "id": "s5", "text": "볼록한 유리는 가장자리 면이 기울어 빛을 더 꺾어요.", "gap_before": 0.8, "emph": ["기울어", "꺾어요."] },
    { "id": "s6", "text": "그래서 알맞은 거리에서 빛이 한 점에 모여요.", "gap_before": 0.8, "emph": ["점에", "모여요."] },
    { "id": "s7", "text": "넓게 받은 햇빛이 작은 점에 몰려 종이가 뜨거워져요.", "gap_before": 0.8, "emph": ["몰려", "뜨거워져요."] },
    { "id": "s8", "text": "그래서 돋보기는 햇빛을 한 점에 모아 종이를 태워요.", "gap_before": 1.0, "emph": ["모아", "태워요."] }
  ]
}
