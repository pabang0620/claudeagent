{
  "segments": [
    { "id": "s1", "text": "기러기들이 하늘을 브이자로 날아가요.", "gap_before": 1.2 },
    { "id": "s2", "text": "그냥 줄 선 게 아니라, 자리마다 힘든 정도가 달라요.", "gap_before": 0.6 },
    { "id": "s3", "text": "날개를 칠 때마다 날개 끝에 공기가 소용돌이쳐요.", "gap_before": 0.7 },
    { "id": "s4", "text": "그 뒤 바깥쪽엔 공기가 위로 떠올라요.", "gap_before": 0.4 },
    { "id": "s5", "text": "뒤따르는 새가 거기 맞춰 날면 힘이 덜 들어요.", "gap_before": 0.4 },
    { "id": "s6", "text": "그래서 다들 비스듬히 자리를 잡아요.", "gap_before": 0.4 },
    { "id": "s7", "text": "여럿이 늘어서면 브이자가 돼요.", "gap_before": 0.3 },
    { "id": "s8", "text": "맨 앞자리는 그 덕을 못 봐 제일 힘들어요.", "gap_before": 0.5 },
    { "id": "s9", "text": "그래서 날면서 자리를 돌아가며 바꿔요.", "gap_before": 0.4 },
    { "id": "s10", "text": "새들은 앞 새가 만든 바람을 타려고 브이자로 날아요.", "gap_before": 0.7 }
  ]
}
