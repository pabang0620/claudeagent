{
  "segments": [
    { "id": "s1", "text": "개미가 자기 몸보다 큰 과자를 번쩍 들어요.", "gap_before": 1.0, "emph": ["번쩍"] },
    { "id": "s2", "text": "힘만 보면 코끼리가 세요. 몸무게 대비는 개미예요.", "gap_before": 0.8, "emph": ["코끼리가", "개미예요"] },
    { "id": "s3", "text": "근육을 자른 면, 단면이 넓을수록 섬유가 많아 세요.", "gap_before": 0.8, "emph": ["넓을수록", "섬유가"] },
    { "id": "s4", "text": "몸을 같은 모양으로 키우면 단면은 두 방향으로 늘어요.", "gap_before": 0.8, "emph": ["모양으로", "두"] },
    { "id": "s5", "text": "그런데 몸무게는 속이 찬 양이라 세 방향으로 늘어요.", "gap_before": 0.8, "emph": ["양이라", "세"] },
    { "id": "s6", "text": "단면보다 몸무게가 빨리 늘어서 큰 몸이 불리해요.", "gap_before": 0.8, "emph": ["빨리", "불리해요"] },
    { "id": "s7", "text": "그래서 작은 개미는 무게에 비해 근육이 굵은 셈이에요.", "gap_before": 0.8, "emph": ["작은", "굵은"] },
    { "id": "s8", "text": "개미는 남는 힘으로 몸보다 큰 과자를 번쩍 들어요.", "gap_before": 0.8, "emph": ["남는", "번쩍"] }
  ]
}
