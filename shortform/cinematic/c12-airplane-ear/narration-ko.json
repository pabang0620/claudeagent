{
  "segments": [
    { "id": "s1", "text": "비행기가 이륙하면 귀가 먹먹해질 때가 있어요.", "gap_before": 1.2 },
    { "id": "s2", "text": "사실 귀 안엔 압력 맞추는 관이 원래 있거든요.", "gap_before": 0.6 },
    { "id": "s3", "text": "근데 이 관은 평소엔 닫혀 있어요.", "gap_before": 0.5 },
    { "id": "s4", "text": "이착륙할 때는 기압이 아주 빨리 바뀌어요.", "gap_before": 0.8 },
    { "id": "s5", "text": "관이 못 따라가면 고막이 팽팽해져요.", "gap_before": 0.4 },
    { "id": "s6", "text": "하품하거나 침을 삼키면 관이 열려요.", "gap_before": 0.4 },
    { "id": "s7", "text": "이 관을 귀인두관이라고 해요.", "gap_before": 0.5 },
    { "id": "s8", "text": "그래서 기압 차이로 귀가 먹먹해지는 거예요.", "gap_before": 0.6 }
  ]
}
