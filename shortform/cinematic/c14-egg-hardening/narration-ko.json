{
  "segments": [
    { "id": "s1", "text": "냄비에 달걀을 넣고 삶아요.", "gap_before": 1.2 },
    { "id": "s2", "text": "원래 흰자는 그냥 흐르는 액체였는데", "gap_before": 0.6 },
    { "id": "s3", "text": "삶고 나면 완전히 딱딱하게 굳어요.", "gap_before": 0.5 },
    { "id": "s4", "text": "흰자 속엔 작은 단백질들이 동동 떠 있어요.", "gap_before": 0.8 },
    { "id": "s5", "text": "돌돌 말린 모양이 열을 받으면 풀려요.", "gap_before": 0.4 },
    { "id": "s6", "text": "풀린 것들이 서로 엉겨서 그물처럼 짜여요.", "gap_before": 0.4 },
    { "id": "s7", "text": "그 그물이 물을 그대로 가둔 채 굳어요.", "gap_before": 0.4 },
    { "id": "s8", "text": "이렇게 굳는 걸 응고라고 해요.", "gap_before": 0.5 },
    { "id": "s9", "text": "그래서 삶은 달걀 흰자가 딱딱해지는 거예요.", "gap_before": 0.6 }
  ]
}
