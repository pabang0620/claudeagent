{
  "segments": [
    { "id": "s1", "text": "베이킹소다에 식초를 부으면 거품이 올라와요.", "gap_before": 1.0, "emph": ["부으면", "거품이"] },
    { "id": "s2", "text": "끓어서 나오는 거품이 아니에요.", "gap_before": 0.81, "emph": ["아니에요."] },
    { "id": "s3", "text": "가루와 식초가 만나야 거품이 생겨요.", "gap_before": 0.7, "emph": ["만나야", "생겨요."] },
    { "id": "s4", "text": "식초의 신맛 성분이 가루에 닿아요.", "gap_before": 0.8, "emph": ["신맛", "닿아요."] },
    { "id": "s5", "text": "가루 속 성분이 이산화탄소 기체로 바뀌어요.", "gap_before": 0.8, "emph": ["이산화탄소", "바뀌어요."] },
    { "id": "s6", "text": "기체 방울은 식초보다 가벼워 떠올라요.", "gap_before": 0.8, "emph": ["가벼워", "떠올라요."] },
    { "id": "s7", "text": "식초가 남아도 가루가 다 쓰이면 멈춰요.", "gap_before": 0.8, "emph": ["남아도", "쓰이면"] },
    { "id": "s8", "text": "결국 거품은 이산화탄소 기체 방울이에요.", "gap_before": 1.0, "emph": ["이산화탄소", "기체"] }
  ]
}
