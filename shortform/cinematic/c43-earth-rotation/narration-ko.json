{
  "segments": [
    { "id": "s1", "text": "굼구미가 평소처럼 가만히 서 있어요.", "gap_before": 1.2 },
    { "id": "s2", "text": "근데 지금 엄청난 속도로 돌고 있거든요.", "gap_before": 0.6 },
    { "id": "s3", "text": "그런데도 하나도 못 느껴요.", "gap_before": 0.5 },
    { "id": "s4", "text": "귀 속 평형 기관은 속도가 변하는 순간만 느껴요.", "gap_before": 0.6 },
    { "id": "s5", "text": "근데 지구는 자전 속도가 늘 한결같거든요.", "gap_before": 0.4 },
    { "id": "s6", "text": "그래서 몸이 느낄 변화 자체가 없는 거예요.", "gap_before": 0.4 },
    { "id": "s7", "text": "비행기가 일정한 속도로 날 땐 멈춘 것 같죠.", "gap_before": 0.5 },
    { "id": "s8", "text": "근데 갑자기 흔들리면 그제야 느껴지잖아요.", "gap_before": 0.3 },
    { "id": "s9", "text": "지구도 자전 속도가 안 바뀌니까 똑같은 거예요.", "gap_before": 0.5 },
    { "id": "s10", "text": "그래서 이렇게 빨리 돌아도 못 느끼는 거예요.", "gap_before": 0.6 }
  ]
}
