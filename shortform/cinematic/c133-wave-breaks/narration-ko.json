{
  "segments": [
    { "id": "s1", "text": "바닷가에서 파도가 밀려와 하얗게 부서져요.", "gap_before": 1.0, "emph": ["밀려와", "부서져요"] },
    { "id": "s2", "text": "바람이 없어도 먼 곳에서 온 파도는 부서져요.", "gap_before": 0.8, "emph": ["없어도", "부서져요"] },
    { "id": "s3", "text": "바람 때문이 아니에요.", "gap_before": 0.5, "emph": ["아니에요"] },
    { "id": "s4", "text": "파도가 얕은 바다에 오면 아래쪽이 바닥에 끌려요.", "gap_before": 0.8, "emph": ["얕은", "끌려요"] },
    { "id": "s5", "text": "그래서 파도 아래쪽이 느려지고 위쪽은 앞서가요.", "gap_before": 1.0, "emph": ["느려지고", "앞서가요"] },
    { "id": "s6", "text": "그러면 파도 꼭대기가 앞으로 기울어요.", "gap_before": 0.8, "emph": ["꼭대기가", "기울어요"] },
    { "id": "s7", "text": "기운 꼭대기는 버티지 못하고 앞으로 넘어져요.", "gap_before": 0.8, "emph": ["버티지", "넘어져요"] },
    { "id": "s8", "text": "그래서 파도는 바다가 얕아지는 곳에서 부서져요.", "gap_before": 1.0, "emph": ["얕아지는", "부서져요"] }
  ]
}
