{
  "segments": [
    { "id": "s1", "text": "고양이가 소파에서 몸이 기울면서 떨어져요.", "gap_before": 1.2 },
    { "id": "s2", "text": "붙잡을 것도, 밀어낼 벽도 없거든요.", "gap_before": 0.5 },
    { "id": "s3", "text": "그런데도 허공에서 몸을 뒤집어 발부터 착지해요.", "gap_before": 0.6 },
    { "id": "s4", "text": "귀 속 평형 기관이 방향을 바로 알아채요.", "gap_before": 0.8 },
    { "id": "s5", "text": "등뼈가 유연해서 몸통을 앞뒤로 나눠 비틀어요.", "gap_before": 0.4 },
    { "id": "s6", "text": "앞다리 붙이고 뒷다리 펴서 앞쪽부터 돌려요.", "gap_before": 0.4 },
    { "id": "s7", "text": "반대로 뒷다리 붙이고 앞다리 펴서 돌려요.", "gap_before": 0.4 },
    { "id": "s8", "text": "이걸 정위반사라고 해요.", "gap_before": 0.5 },
    { "id": "s9", "text": "그래서 고양이는 떨어져도 발부터 땅에 닿는 거예요.", "gap_before": 0.6 }
  ]
}
