{
  "segments": [
    { "id": "s1", "text": "굼구미가 뜨거운 냄비 손잡이를 잡아요.", "gap_before": 1.2 },
    { "id": "s2", "text": "손이 눈 깜짝할 새 확 떨어져요.", "gap_before": 0.5 },
    { "id": "s3", "text": "근데 아픈 느낌은 그 다음에 와요.", "gap_before": 0.5 },
    { "id": "s4", "text": "손끝 속으로 확대해서 볼게요.", "gap_before": 0.6 },
    { "id": "s5", "text": "손끝 신경이 위험 신호를 보내요.", "gap_before": 0.5 },
    { "id": "s6", "text": "신호가 뇌 대신 등뼈 속에서 갈아타요.", "gap_before": 0.4 },
    { "id": "s7", "text": "곧장 팔 근육에 손 떼라 명령해요.", "gap_before": 0.4 },
    { "id": "s8", "text": "신호가 뇌에 닿아야 아픔이 느껴져요.", "gap_before": 0.4 },
    { "id": "s9", "text": "이런 빠른 반응을 척수 반사라고 해요.", "gap_before": 0.5 },
    { "id": "s10", "text": "냄비를 만졌을 때도 이렇게 일어난 거예요.", "gap_before": 0.5 },
    { "id": "s11", "text": "손이 떨어진 뒤에야 아픔을 느끼는 거예요.", "gap_before": 0.6 }
  ]
}
