{
  "segments": [
    { "id": "s1", "text": "굼구미가 눈 오는 공원에서 휴대폰을 봐요.", "gap_before": 1.1 },
    { "id": "s2", "text": "방금 충전해서 배터리가 가득해요.", "gap_before": 0.6 },
    { "id": "s3", "text": "근데 밖에서 순식간에 뚝 떨어져요.", "gap_before": 0.5 },
    { "id": "s4", "text": "배터리 속을 확대해서 볼게요.", "gap_before": 0.6 },
    { "id": "s5", "text": "배터리 속 이온이라는 알갱이가 전기를 만들어요.", "gap_before": 0.5 },
    { "id": "s6", "text": "근데 추워지면 액체가 뻑뻑해져요.", "gap_before": 0.4 },
    { "id": "s7", "text": "액체가 뻑뻑하면 이온이 느려져요.", "gap_before": 0.4 },
    { "id": "s8", "text": "그래서 전기 낼 힘이 확 줄어요.", "gap_before": 0.4 },
    { "id": "s9", "text": "이렇게 뻑뻑해지는 정도를 점성이라고 해요.", "gap_before": 0.5 },
    { "id": "s10", "text": "따뜻해지면 액체가 묽어지고 힘도 돌아와요.", "gap_before": 0.5 },
    { "id": "s11", "text": "추우면 액체가 뻑뻑해져서 힘이 줄어드는 거예요.", "gap_before": 0.6 }
  ]
}
