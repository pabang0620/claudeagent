{
  "segments": [
    { "id": "s1", "text": "바다 위 갈매기가 바닷물을 꿀꺽 마셔요.", "gap_before": 1.0, "emph": ["바닷물을", "꿀꺽"] },
    { "id": "s2", "text": "우리는 바닷물을 마시면 소금 때문에 더 목말라요.", "gap_before": 0.8, "emph": ["소금", "목말라요."] },
    { "id": "s3", "text": "그렇다고 갈매기 몸이 짠물에 강한 건 아니에요.", "gap_before": 0.7, "emph": ["강한", "아니에요."] },
    { "id": "s4", "text": "바닷물을 마시면 갈매기 피에 소금이 늘어 위험해요.", "gap_before": 0.8, "emph": ["소금이", "위험해요."] },
    { "id": "s5", "text": "그러면 눈 위 염샘이 피 속 소금을 걸러 내요.", "gap_before": 0.8, "emph": ["염샘이", "걸러"] },
    { "id": "s6", "text": "걸러 낸 진한 소금물이 부리 끝에서 똑 떨어져요.", "gap_before": 0.8, "emph": ["진한", "똑"] },
    { "id": "s7", "text": "소금이 빠져나가니 피 속 소금이 알맞게 유지돼요.", "gap_before": 0.8, "emph": ["빠져나가니", "유지돼요."] },
    { "id": "s8", "text": "갈매기는 염샘으로 소금을 내보내서 바닷물을 마셔요.", "gap_before": 1.0, "emph": ["염샘으로", "내보내서"] }
  ]
}
