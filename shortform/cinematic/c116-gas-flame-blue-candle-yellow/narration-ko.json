{
  "segments": [
    { "id": "s1", "text": "가스불은 파란색이에요.", "gap_before": 1.0, "emph": ["파란색이에요"] },
    { "id": "s2", "text": "촛불은 노란색이에요.", "gap_before": 0.7, "emph": ["노란색이에요"] },
    { "id": "s3", "text": "연료 때문만은 아니에요.", "gap_before": 0.6, "emph": ["연료", "아니에요"] },
    { "id": "s4", "text": "같은 가스도 공기를 막으면 노랗게 타요.", "gap_before": 0.6, "emph": ["공기를", "노랗게"] },
    { "id": "s5", "text": "공기가 모자라면 연료가 덜 타서 그을음이 생겨요.", "gap_before": 0.8, "emph": ["모자라면", "그을음이"] },
    { "id": "s6", "text": "불 속 그을음 알갱이가 달궈져 노랗게 빛나요.", "gap_before": 0.6, "emph": ["달궈져", "노랗게"] },
    { "id": "s7", "text": "촛불은 초 기체에 공기가 덜 닿아 그을음이 생겨요.", "gap_before": 0.6, "emph": ["공기가", "덜"] },
    { "id": "s8", "text": "가스는 공기와 미리 섞여 나와 그을음이 거의 없어요.", "gap_before": 0.6, "emph": ["섞여", "없어요"] },
    { "id": "s9", "text": "그을음이 없으면 타는 기체 자체의 푸른빛만 보여요.", "gap_before": 0.6, "emph": ["없으면", "푸른빛만"] },
    { "id": "s10", "text": "촛불은 그을음 때문에 노랗고 가스불은 파래요.", "gap_before": 0.8, "emph": ["그을음", "파래요"] }
  ]
}
