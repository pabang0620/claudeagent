{
  "segments": [
    { "id": "s1", "text": "수건 끝을 물에 담가 두면 물이 위로 올라와요.", "gap_before": 1.0, "emph": ["위로", "올라와요"] },
    { "id": "s2", "text": "물은 아래로만 흐르는 게 아니에요.", "gap_before": 0.8, "emph": ["아니에요"] },
    { "id": "s3", "text": "면 수건은 실을 촘촘히 짜서 틈이 아주 좁아요.", "gap_before": 0.8, "emph": ["촘촘히", "좁아요"] },
    { "id": "s4", "text": "면 실은 물과 잘 붙어서 물이 실을 타고 퍼져요.", "gap_before": 0.6, "emph": ["붙어서", "퍼져요"] },
    { "id": "s5", "text": "틈 양쪽 실에 붙은 물이 가운데 물을 위로 끌어당겨요.", "gap_before": 0.6, "emph": ["붙은", "끌어당겨요"] },
    { "id": "s6", "text": "틈이 좁으면 실이 가까워 물이 더 높이 올라가요.", "gap_before": 0.6, "emph": ["좁으면", "높이"] },
    { "id": "s7", "text": "그래서 면 실 사이 좁은 틈이 물을 끌어올려요.", "gap_before": 0.8, "emph": ["좁은", "끌어올려요"] }
  ]
}
