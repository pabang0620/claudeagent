{
  "segments": [
    { "id": "s1", "text": "냄비에 우유를 데워요.", "gap_before": 1.0, "emph": ["우유를"] },
    { "id": "s2", "text": "한눈판 사이 우유가 넘쳐 흘러요.", "gap_before": 0.8, "emph": ["넘쳐"] },
    { "id": "s3", "text": "불이 세서 넘치는 게 아니에요.", "gap_before": 0.7, "emph": ["세서"] },
    { "id": "s4", "text": "같은 불에서도 물은 보통 안 넘쳐요.", "gap_before": 0.7, "emph": ["물은", "안"] },
    { "id": "s5", "text": "뜨거운 우유 표면에서 단백질이 엉겨 막이 돼요.", "gap_before": 0.9, "emph": ["단백질이", "막이"] },
    { "id": "s6", "text": "냄비 바닥의 우유가 끓어 수증기 방울이 생겨요.", "gap_before": 0.7, "emph": ["수증기"] },
    { "id": "s7", "text": "물은 방울이 터지지만 우유는 막에 갇혀요.", "gap_before": 0.7, "emph": ["터지지만", "갇혀요"] },
    { "id": "s8", "text": "막 밑에 쌓인 수증기가 막을 밀어 올려요.", "gap_before": 0.7, "emph": ["쌓인", "밀어"] },
    { "id": "s9", "text": "우유는 표면의 막이 수증기를 가둬 넘쳐요.", "gap_before": 0.9, "emph": ["막이", "가둬"] }
  ]
}
