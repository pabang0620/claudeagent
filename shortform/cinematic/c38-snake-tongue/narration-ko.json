{
  "segments": [
    { "id": "s1", "text": "뱀이 혀를 날름날름 내밀어요.", "gap_before": 1.3 },
    { "id": "s2", "text": "코는 숨만 쉬고, 냄새는 혀가 맡아 와요.", "gap_before": 0.6 },
    { "id": "s3", "text": "혀를 날름거려 냄새 입자를 묻혀 와요.", "gap_before": 0.8 },
    { "id": "s4", "text": "혀끝 두 갈래가 입천장 감지기관에 닿아요.", "gap_before": 0.4 },
    { "id": "s5", "text": "양쪽 끝의 냄새 진하기가 서로 달라요.", "gap_before": 0.4 },
    { "id": "s6", "text": "더 진한 쪽으로 먹잇감 방향을 알아내요.", "gap_before": 0.4 },
    { "id": "s7", "text": "이 감지기관을 야콥슨기관이라고 해요.", "gap_before": 0.5 },
    { "id": "s8", "text": "그쪽으로 방향을 틀어 사냥감을 찾아가요.", "gap_before": 0.6 },
    { "id": "s9", "text": "혀를 날름거려 먹잇감 방향을 알아내는 거예요.", "gap_before": 0.6 }
  ]
}
