{
  "segments": [
    { "id": "s1", "text": "젖은 강아지가 몸을 털면 물이 사방으로 날아가요.", "gap_before": 1.0, "emph": ["털면", "사방으로"] },
    { "id": "s2", "text": "개가 물을 던지는 게 아니에요.", "gap_before": 0.8, "emph": ["아니에요"] },
    { "id": "s3", "text": "물방울은 털에 달라붙어 있을 뿐이에요.", "gap_before": 0.8, "emph": ["달라붙어", "뿐이에요"] },
    { "id": "s4", "text": "개가 몸을 빠르게 비틀면 털도 같이 휙 움직여요.", "gap_before": 0.8, "emph": ["비틀면", "휙"] },
    { "id": "s5", "text": "움직이던 물방울은 그대로 가려 해요.", "gap_before": 0.8, "emph": ["그대로", "가려"] },
    { "id": "s6", "text": "털이 꺾이면 물방울은 못 따라가 떨어져요.", "gap_before": 0.6, "emph": ["못", "떨어져요"] },
    { "id": "s7", "text": "그래서 몸을 털면 물방울이 가던 쪽으로 날아가요.", "gap_before": 0.8, "emph": ["가던", "날아가요"] }
  ]
}
