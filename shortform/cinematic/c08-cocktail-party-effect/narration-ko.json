{
  "segments": [
    { "id": "s1", "text": "굼구미가 시끌시끌한 파티에서 친구랑 얘기해요.", "gap_before": 1.2 },
    { "id": "s2", "text": "지금 대화 말고 다른 소리는 안 들리는 것 같죠.", "gap_before": 0.6 },
    { "id": "s3", "text": "근데 누가 내 이름을 부르면 바로 딱 걸려요.", "gap_before": 0.5 },
    { "id": "s4", "text": "그 이유는 뇌 속에 있어요.", "gap_before": 0.6 },
    { "id": "s5", "text": "뇌는 지금 목소리 하나만 밝게 골라 들어요.", "gap_before": 0.5 },
    { "id": "s6", "text": "근데 나머지 소리도 작게 계속 감지돼요.", "gap_before": 0.4 },
    { "id": "s7", "text": "거기서 내 이름처럼 익숙한 소리가 튀어요.", "gap_before": 0.4 },
    { "id": "s8", "text": "그 순간 뇌가 주의를 그쪽으로 확 돌려요.", "gap_before": 0.4 },
    { "id": "s9", "text": "이걸 칵테일파티 효과라고 해요.", "gap_before": 0.5 },
    { "id": "s10", "text": "그래서 시끄러워도 내 이름은 딱 들리는 거예요.", "gap_before": 0.6 }
  ]
}
