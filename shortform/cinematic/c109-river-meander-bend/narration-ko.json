{
  "segments": [
    { "id": "s1", "text": "강을 위에서 보면 구불구불 휘어 있어요.", "gap_before": 1.0, "emph": ["구불구불", "휘어"] },
    { "id": "s2", "text": "평평한 들판에서도 강은 돌아서 흘러요.", "gap_before": 0.8, "emph": ["평평한", "돌아서"] },
    { "id": "s3", "text": "바위를 피해 도는 게 아니에요.", "gap_before": 0.7, "emph": ["바위를", "아니에요"] },
    { "id": "s4", "text": "빠르게 달리던 물은 휜 곳에서 바깥쪽으로 쏠려요.", "gap_before": 0.9, "emph": ["바깥쪽으로", "쏠려요"] },
    { "id": "s5", "text": "그래서 바깥쪽 강가는 세게 부딪혀 깎여요.", "gap_before": 0.7, "emph": ["세게", "깎여요"] },
    { "id": "s6", "text": "물이 바깥으로 쏠려 안쪽은 느려, 깎인 흙이 쌓여요.", "gap_before": 0.7, "emph": ["느려", "쌓여요"] },
    { "id": "s7", "text": "바깥은 깎이고 안쪽은 쌓여서 강이 더 휘어요.", "gap_before": 0.8, "emph": ["깎이고", "쌓여서"] },
    { "id": "s8", "text": "강은 휜 곳마다 깎이고 쌓이며 더 구불구불해져요.", "gap_before": 1.0, "emph": ["깎이고", "구불구불해져요"] }
  ]
}
