{
  "segments": [
    { "id": "s1", "text": "비닐에 싼 식빵도 시간이 지나면 딱딱해져요.", "gap_before": 1.0, "emph": ["비닐에", "딱딱해져요"] },
    { "id": "s2", "text": "물이 날아가서만 그런 게 아니에요.", "gap_before": 0.8, "emph": ["아니에요"] },
    { "id": "s3", "text": "밀가루 속 녹말은 구울 때 물을 머금고 부풀어요.", "gap_before": 0.8, "emph": ["머금고", "부풀어요"] },
    { "id": "s4", "text": "그래서 갓 구운 빵 속이 말랑해요.", "gap_before": 0.8, "emph": ["말랑해요"] },
    { "id": "s5", "text": "식고 시간이 지나면 녹말끼리 다시 달라붙어요.", "gap_before": 0.8, "emph": ["지나면", "달라붙어요"] },
    { "id": "s6", "text": "촘촘히 붙은 녹말 탓에 빵이 단단해져요.", "gap_before": 0.8, "emph": ["촘촘히", "단단해져요"] },
    { "id": "s7", "text": "물 안 넣고 데워도 붙은 녹말이 열로 풀려요.", "gap_before": 0.8, "emph": ["데워도", "풀려요"] },
    { "id": "s8", "text": "그래서 시간이 지난 빵은 녹말이 굳어서 딱딱해요.", "gap_before": 0.8, "emph": ["녹말이", "굳어서"] }
  ]
}
