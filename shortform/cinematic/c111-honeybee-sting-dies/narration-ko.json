{
  "segments": [
    { "id": "s1", "text": "꿀벌이 사람을 쏘고 나면 죽어요.", "gap_before": 1.0, "emph": ["쏘고", "죽어요"] },
    { "id": "s2", "text": "벌이 일부러 죽으려는 게 아니에요.", "gap_before": 0.8, "emph": ["일부러"] },
    { "id": "s3", "text": "죽는 건 침 끝 모양 때문이에요.", "gap_before": 0.7, "emph": ["모양"] },
    { "id": "s4", "text": "꿀벌 침에는 뒤로 굽은 작은 갈고리가 있어요.", "gap_before": 0.8, "emph": ["굽은", "갈고리가"] },
    { "id": "s5", "text": "피부에 박힌 침을 빼려 하면 갈고리가 걸려요.", "gap_before": 0.8, "emph": ["빼려", "걸려요"] },
    { "id": "s6", "text": "벌이 날아가면 침이 안 빠지고 배 끝이 뜯겨요.", "gap_before": 0.7, "emph": ["빠지고", "뜯겨요"] },
    { "id": "s7", "text": "몸속 일부도 같이 뜯겨 꿀벌은 곧 죽어요.", "gap_before": 0.7, "emph": ["몸속", "죽어요"] },
    { "id": "s8", "text": "걸리는 침 때문에 사람을 쏜 꿀벌은 죽어요.", "gap_before": 0.9, "emph": ["걸리는", "죽어요"] }
  ]
}
