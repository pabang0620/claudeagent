{
  "segments": [
    { "id": "s1", "text": "밤이 되면 유리창에 내 모습이 비쳐요.", "gap_before": 1.0, "emph": ["비쳐요"] },
    { "id": "s2", "text": "유리창이 거울로 바뀌는 게 아니에요.", "gap_before": 0.8, "emph": ["바뀌는", "아니에요"] },
    { "id": "s3", "text": "전등 빛이 내 몸에 닿아 사방으로 퍼져요.", "gap_before": 0.8, "emph": ["내", "퍼져요"] },
    { "id": "s4", "text": "퍼진 빛은 유리창을 대부분 통과하고 조금 반사해요.", "gap_before": 0.8, "emph": ["통과하고", "조금"] },
    { "id": "s5", "text": "낮에는 바깥 빛이 반사된 빛보다 훨씬 많아요.", "gap_before": 0.8, "emph": ["훨씬", "많아요"] },
    { "id": "s6", "text": "그래서 내 모습은 눈에 안 띄어요.", "gap_before": 0.8, "emph": ["그래서", "안"] },
    { "id": "s7", "text": "밤에는 바깥 빛이 줄어 내 모습이 드러나요.", "gap_before": 0.8, "emph": ["줄어", "드러나요"] },
    { "id": "s8", "text": "방 불을 끄면 내 모습이 옅어져 바깥이 보여요.", "gap_before": 0.8, "emph": ["끄면", "바깥이"] }
  ]
}
