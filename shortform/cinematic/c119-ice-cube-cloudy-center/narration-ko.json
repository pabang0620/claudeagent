{
  "segments": [
    { "id": "s1", "text": "얼음 틀에 물을 담아 얼려요.", "gap_before": 1.0, "emph": ["얼려요"] },
    { "id": "s2", "text": "꺼낸 얼음 가운데가 뿌여요.", "gap_before": 0.8, "emph": ["가운데가"] },
    { "id": "s3", "text": "물이 흐려서가 아니에요.", "gap_before": 0.7, "emph": ["흐려서가"] },
    { "id": "s4", "text": "물속에는 공기가 녹아 있거든요.", "gap_before": 0.7, "emph": ["공기가"] },
    { "id": "s5", "text": "물은 냉기가 바깥에서 오니까 바깥부터 얼어요.", "gap_before": 0.9, "emph": ["바깥에서", "바깥부터"] },
    { "id": "s6", "text": "촘촘히 굳는 얼음 안엔 공기가 못 들어가요.", "gap_before": 0.7, "emph": ["촘촘히", "못"] },
    { "id": "s7", "text": "밀려난 공기는 가운데 남은 물에 모여요.", "gap_before": 0.7, "emph": ["밀려난", "모여요"] },
    { "id": "s8", "text": "마지막에 가운데가 얼며 공기가 갇혀요.", "gap_before": 0.7, "emph": ["마지막에", "갇혀요"] },
    { "id": "s9", "text": "갇힌 공기가 빛을 흩어요.", "gap_before": 0.9, "emph": ["흩어요"] },
    { "id": "s10", "text": "그래서 가운데가 뿌예요.", "gap_before": 1.0, "emph": ["가운데가", "뿌예요"] }
  ]
}
