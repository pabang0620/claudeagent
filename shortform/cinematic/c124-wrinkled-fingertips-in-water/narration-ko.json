{
  "segments": [
    { "id": "s1", "text": "목욕을 오래 하면 손끝이 쭈글쭈글해져요.", "gap_before": 1.0, "emph": ["쭈글쭈글해져요"] },
    { "id": "s2", "text": "이 주름은 물에 불어서만 생기는 게 아니에요.", "gap_before": 0.9, "emph": ["불어서만"] },
    { "id": "s3", "text": "물에 오래 닿으면 손끝 신경이 신호를 보내요.", "gap_before": 2.3, "emph": ["오래", "신경이"] },
    { "id": "s4", "text": "손끝 혈관이 그 신호를 받아 좁아져요.", "gap_before": 0.8, "emph": ["혈관이", "좁아져요"] },
    { "id": "s5", "text": "손끝에 피가 덜 차면 속살이 쪼그라들어요.", "gap_before": 0.7, "emph": ["속살이", "쪼그라들어요"] },
    { "id": "s6", "text": "그런데 겉피부는 줄지 않고 남아 있어요.", "gap_before": 0.7, "emph": ["겉피부는", "줄지"] },
    { "id": "s7", "text": "속살은 줄고 남은 겉피부가 접혀 주름져요.", "gap_before": 0.8, "emph": ["줄고", "접혀"] }
  ]
}
