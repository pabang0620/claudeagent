{
  "segments": [
    { "id": "s1", "text": "고양이가 캄캄한 마당에 앉아 있어요.", "gap_before": 1.2 },
    { "id": "s2", "text": "손전등을 비추면 눈이 확 빛나요.", "gap_before": 0.6 },
    { "id": "s3", "text": "근데 빛이 없으면 안 빛나요.", "gap_before": 0.5 },
    { "id": "s4", "text": "눈 속으로 확대해서 볼게요.", "gap_before": 0.5 },
    { "id": "s5", "text": "들어온 빛은 망막을 통과해요.", "gap_before": 0.5 },
    { "id": "s6", "text": "반사층이 그 빛을 튕겨내요.", "gap_before": 0.4 },
    { "id": "s7", "text": "튕긴 빛이 망막을 다시 지나가요.", "gap_before": 0.4 },
    { "id": "s8", "text": "그래서 어두운 곳도 더 잘 보여요.", "gap_before": 0.3 },
    { "id": "s9", "text": "반사된 빛 일부는 눈 밖으로 나가요.", "gap_before": 0.4 },
    { "id": "s10", "text": "그 빛이 바로 우리가 보는 반짝임이에요.", "gap_before": 0.5 },
    { "id": "s11", "text": "빛이 있어야만 고양이 눈이 빛나 보여요.", "gap_before": 0.6 }
  ]
}
