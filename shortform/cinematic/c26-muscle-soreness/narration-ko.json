{
  "segments": [
    { "id": "s1", "text": "오랜만에 운동한 다음날, 온몸이 욱신거려요.", "gap_before": 1.2 },
    { "id": "s2", "text": "젖산 때문이라고 생각하지만, 젖산은 금방 사라져요.", "gap_before": 0.6 },
    { "id": "s3", "text": "근데 아픈 건 하루 이틀 지나서 시작돼요.", "gap_before": 0.5 },
    { "id": "s4", "text": "안 쓰던 근육을 움직이면 섬유에 작은 상처가 생겨요.", "gap_before": 0.7 },
    { "id": "s5", "text": "상처를 고치려고 염증 반응이 일어나요.", "gap_before": 0.4 },
    { "id": "s6", "text": "염증이 통증 신경을 자극해서 예민하게 만들어요.", "gap_before": 0.4 },
    { "id": "s7", "text": "이 회복 과정이 하루 이틀 걸려요.", "gap_before": 0.4 },
    { "id": "s8", "text": "그래서 당일이 아니라 다음날 더 아픈 거예요.", "gap_before": 0.6 },
    { "id": "s9", "text": "손상을 고치는 염증 때문에 며칠 동안 아픈 거예요.", "gap_before": 0.5 }
  ]
}
