{
  "segments": [
    { "id": "s1", "text": "굼구미가 시원한 물을 마셔요.", "gap_before": 1.2 },
    { "id": "s2", "text": "이빨 겉은 다 똑같이 단단해요.", "gap_before": 0.6 },
    { "id": "s3", "text": "근데 한 곳만 유독 시큰거려요.", "gap_before": 0.5 },
    { "id": "s4", "text": "안쪽을 확대해서 볼게요.", "gap_before": 0.6 },
    { "id": "s5", "text": "에나멜 안쪽엔 상아질이 있어요.", "gap_before": 0.5 },
    { "id": "s6", "text": "거기엔 신경까지 이어진 관이 있어요.", "gap_before": 0.4 },
    { "id": "s7", "text": "그 관 속엔 액체가 차 있어요.", "gap_before": 0.4 },
    { "id": "s8", "text": "찬물 닿으면 액체가 훅 움직여요.", "gap_before": 0.4 },
    { "id": "s9", "text": "신경이 그 움직임을 시림으로 읽어요.", "gap_before": 0.4 },
    { "id": "s10", "text": "다시 보면 그 자리만 콕 시려요.", "gap_before": 0.5 },
    { "id": "s11", "text": "관 속 액체가 움직여서 이가 시려요.", "gap_before": 0.6 }
  ]
}
