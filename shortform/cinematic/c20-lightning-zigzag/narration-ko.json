{
  "segments": [
    { "id": "s1", "text": "창밖에 번개가 지그재그로 내리쳐요.", "gap_before": 1.2 },
    { "id": "s2", "text": "근데 사실 공기는 전기가 잘 안 통하거든요.", "gap_before": 0.6 },
    { "id": "s3", "text": "번개 끝부분을 확대해서 볼게요.", "gap_before": 0.5 },
    { "id": "s4", "text": "번개는 아주 짧은 구간씩 끊어서 나아가요.", "gap_before": 0.5 },
    { "id": "s5", "text": "그때그때 공기가 더 잘 통하는 쪽으로 틀어요.", "gap_before": 0.4 },
    { "id": "s6", "text": "공기 중 잘 통하는 곳은 여기저기 흩어져 있거든요.", "gap_before": 0.4 },
    { "id": "s7", "text": "그래서 꺾인 구간들이 이어지면서 지그재그가 돼요.", "gap_before": 0.4 },
    { "id": "s8", "text": "창밖의 번개도 똑같이 만들어진 거예요.", "gap_before": 0.6 },
    { "id": "s9", "text": "번개는 그때그때 더 잘 통하는 쪽으로 꺾이며 나아가요.", "gap_before": 0.5 }
  ]
}
