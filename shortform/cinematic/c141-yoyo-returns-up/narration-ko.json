{
  "segments": [
    { "id": "s1", "text": "줄이 감긴 요요를 놓으면 내려갔다 다시 올라와요.", "gap_before": 1.0, "emph": ["내려갔다", "올라와요."] },
    { "id": "s2", "text": "손이 줄을 당겨서 올라오는 게 아니에요.", "gap_before": 0.7, "emph": ["당겨서", "아니에요."] },
    { "id": "s3", "text": "손은 가만히 있어도 요요는 올라와요.", "gap_before": 0.7, "emph": ["가만히", "올라와요."] },
    { "id": "s4", "text": "내려올 때 중력으로 줄이 풀려 요요가 빨리 돌아요.", "gap_before": 0.8, "emph": ["풀려", "빨리"] },
    { "id": "s5", "text": "도는 요요는 맨 아래서도 멈추지 않고 돌아요.", "gap_before": 0.8, "emph": ["않고", "돌아요."] },
    { "id": "s6", "text": "요요는 맨 아래서 돌면서 줄을 다시 감아 올라와요.", "gap_before": 0.8, "emph": ["다시", "감아"] },
    { "id": "s7", "text": "요요는 올라가는 만큼 회전이 높이로 바뀌어요.", "gap_before": 0.8, "emph": ["회전이", "높이로"] },
    { "id": "s8", "text": "그래서 요요는 내려오며 얻은 회전으로 다시 올라와요.", "gap_before": 1.0, "emph": ["회전으로", "올라와요."] }
  ]
}
