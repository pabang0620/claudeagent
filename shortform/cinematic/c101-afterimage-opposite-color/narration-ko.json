{
  "segments": [
    { "id": "s1", "text": "빨간 하트 그림을 한참 쳐다봤어요.", "gap_before": 1.0, "emph": ["한참"] },
    { "id": "s2", "text": "카드를 치우자 흰 벽에 청록 하트가 떠올라요.", "gap_before": 1.0, "emph": ["청록", "떠올라요"] },
    { "id": "s3", "text": "벽에 그림이 생긴 게 아니에요.", "gap_before": 0.7, "emph": ["아니에요"] },
    { "id": "s4", "text": "눈 안쪽에는 빨강, 초록, 파랑 세포가 있어요.", "gap_before": 0.9, "emph": ["세포가"] },
    { "id": "s5", "text": "계속 자극받은 빨강 세포는 반응이 약해져요.", "gap_before": 0.7, "emph": ["자극받은", "약해져요"] },
    { "id": "s6", "text": "흰 벽의 빛에는 모든 색이 섞여 있어요.", "gap_before": 0.7, "emph": ["모든", "섞여"] },
    { "id": "s7", "text": "하트 자리에서는 빨강 세포만 반응이 약해요.", "gap_before": 0.7, "emph": ["빨강", "약해요"] },
    { "id": "s8", "text": "그래서 초록과 파랑 세포가 빨강보다 강하게 반응해요.", "gap_before": 0.7, "emph": ["빨강보다", "강하게"] },
    { "id": "s9", "text": "초록과 파랑이 섞인 색이 바로 청록이에요.", "gap_before": 0.7, "emph": ["섞인", "청록이에요"] },
    { "id": "s10", "text": "청록 하트는 눈 속 세포가 지쳐서 보여요.", "gap_before": 1.0, "emph": ["눈", "지쳐서"] }
  ]
}
