{
  "segments": [
    { "id": "s1", "text": "회전의자에서 팔을 벌리고 천천히 돌아요.", "gap_before": 1.2, "emph": ["천천히"] },
    { "id": "s2", "text": "팔을 몸쪽으로 모으자 회전이 갑자기 빨라져요.", "gap_before": 0.8, "emph": ["모으자", "빨라져요"] },
    { "id": "s3", "text": "누가 더 세게 밀어준 게 아니에요.", "gap_before": 0.7, "emph": ["아니에요"] },
    { "id": "s4", "text": "팔을 펴면 무게가 의자 축에서 멀리 퍼져요.", "gap_before": 0.9, "emph": ["무게가", "퍼져요"] },
    { "id": "s5", "text": "밀어주는 힘이 없으면 도는 양은 그대로예요.", "gap_before": 0.7, "emph": ["없으면", "그대로예요"] },
    { "id": "s6", "text": "도는 양은 퍼짐과 속도를 곱한 값이에요.", "gap_before": 0.7, "emph": ["퍼짐과", "곱한"] },
    { "id": "s7", "text": "팔을 모아 퍼짐이 줄면 속도가 올라요.", "gap_before": 0.7, "emph": ["줄면", "올라요"] },
    { "id": "s8", "text": "도는 양이 같아서 팔을 모으면 회전이 빨라져요.", "gap_before": 0.9, "emph": ["같아서", "빨라져요"] }
  ]
}
