{
  "segments": [
    { "id": "s1", "text": "끓는 냄비 속 바지락이 입을 벌려요.", "gap_before": 1.0, "emph": ["끓는", "벌려요"] },
    { "id": "s2", "text": "바지락 같은 조개에는 여는 근육이 없어요.", "gap_before": 0.7, "emph": ["여는", "없어요"] },
    { "id": "s3", "text": "뜨거워서 조개가 힘껏 여는 게 아니에요.", "gap_before": 0.5, "emph": ["뜨거워서", "아니에요"] },
    { "id": "s4", "text": "살아 있는 조개는 근육으로 껍데기를 당겨 닫아요.", "gap_before": 0.7, "emph": ["근육으로", "닫아요"] },
    { "id": "s5", "text": "경첩의 탄력 있는 인대는 껍데기를 밀어 벌려요.", "gap_before": 0.7, "emph": ["인대는", "벌려요"] },
    { "id": "s6", "text": "그래서 근육이 당기는 동안만 입이 닫혀 있어요.", "gap_before": 0.4, "emph": ["동안만", "닫혀"] },
    { "id": "s7", "text": "끓는 물에 조개가 죽으면 근육이 힘을 잃어요.", "gap_before": 0.7, "emph": ["죽으면", "잃어요"] },
    { "id": "s8", "text": "그러면 인대가 껍데기를 밀어서 입이 벌어져요.", "gap_before": 0.6, "emph": ["인대가", "벌어져요"] },
    { "id": "s9", "text": "조개는 닫는 힘이 사라져서 입을 벌려요.", "gap_before": 0.9, "emph": ["사라져서", "벌려요"] }
  ]
}
