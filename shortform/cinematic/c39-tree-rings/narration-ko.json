{
  "segments": [
    { "id": "s1", "text": "잘린 나무 그루터기에 나이테가 있어요.", "gap_before": 1.2 },
    { "id": "s2", "text": "그런데 나무는 통째로 자라는 게 아니에요.", "gap_before": 0.5 },
    { "id": "s3", "text": "나무껍질 안쪽 아주 얇은 층에서만 자라요.", "gap_before": 0.8 },
    { "id": "s4", "text": "이 층이 계절마다 다르게 자라요.", "gap_before": 0.4 },
    { "id": "s5", "text": "따뜻할 땐 세포가 크고 성기게 자라 밝아요.", "gap_before": 0.4 },
    { "id": "s6", "text": "추울 땐 세포가 작고 빽빽하게 자라 어두워요.", "gap_before": 0.4 },
    { "id": "s7", "text": "이 두 층 한 쌍이 일 년에 하나씩 생겨요.", "gap_before": 0.5 },
    { "id": "s8", "text": "이 나이테를 세면 나무 나이를 알 수 있어요.", "gap_before": 0.6 }
  ]
}
