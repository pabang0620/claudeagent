{
  "segments": [
    { "id": "s1", "text": "함박눈이 마당에 소복하게 쌓였어요.", "gap_before": 1.0 },
    { "id": "s2", "text": "굼구미가 떨어지는 눈송이 하나를 받아요.", "gap_before": 0.6 },
    { "id": "s3", "text": "눈송이 한 개는 유리알처럼 투명해요.", "gap_before": 0.5 },
    { "id": "s4", "text": "그런데 쌓인 눈은 새하얗잖아요.", "gap_before": 0.5 },
    { "id": "s5", "text": "얼음 결정 하나는 빛을 거의 그대로 통과시켜요.", "gap_before": 0.6 },
    { "id": "s6", "text": "겹겹이 쌓이면 얼음과 공기의 경계면이 무수히 생겨요.", "gap_before": 0.5 },
    { "id": "s7", "text": "빛이 그 면마다 부딪히며 사방으로 흩어져요.", "gap_before": 0.4 },
    { "id": "s8", "text": "얼음은 색을 가리지 않고 골고루 흩뿌려요.", "gap_before": 0.4 },
    { "id": "s9", "text": "이런 현상을 산란이라고 해요.", "gap_before": 0.4 },
    { "id": "s10", "text": "그래서 여러 색이 섞여 하얀빛이 나와요.", "gap_before": 0.5 },
    { "id": "s11", "text": "그래서 눈은 하얗게 보이는 거예요.", "gap_before": 0.5 }
  ]
}
