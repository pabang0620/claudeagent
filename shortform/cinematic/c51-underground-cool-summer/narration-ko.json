{
  "segments": [
    { "id": "s1", "text": "한여름 낮, 굼구미가 지하실 계단을 내려가요.", "gap_before": 1.2 },
    { "id": "s2", "text": "에어컨도 없는데 점점 서늘해져요.", "gap_before": 0.5 },
    { "id": "s3", "text": "한여름 햇볕은 땅 겉부터 데워요.", "gap_before": 1.2 },
    { "id": "s4", "text": "흙과 돌은 열을 아주 느리게 전해요.", "gap_before": 0.5 },
    { "id": "s5", "text": "내려가는 사이 계절이 바뀌어, 더위는 약해져요.", "gap_before": 0.4 },
    { "id": "s6", "text": "깊은 곳은 일 년 내내 여름과 겨울의 중간 온도예요.", "gap_before": 0.5 },
    { "id": "s7", "text": "지하실도 깊어서 여름엔 시원하고, 겨울엔 따뜻해요.", "gap_before": 0.6 }
  ]
}
