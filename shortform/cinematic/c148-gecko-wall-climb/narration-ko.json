{
  "segments": [
    { "id": "s1", "text": "도마뱀붙이가 매끈한 벽을 기어올라요.", "gap_before": 1.0, "emph": ["매끈한", "기어올라요."] },
    { "id": "s2", "text": "도마뱀붙이가 끈끈이 때문에 붙는 게 아니에요.", "gap_before": 0.7, "emph": ["아니에요."] },
    { "id": "s3", "text": "발바닥에는 눈에 안 보이는 가는 털이 나 있어요.", "gap_before": 0.8, "emph": ["가는", "털이"] },
    { "id": "s4", "text": "털 끝은 더 가늘게 갈라져 벽면에 바싹 닿아요.", "gap_before": 0.8, "emph": ["갈라져", "바싹"] },
    { "id": "s5", "text": "아주 가까우면 털 끝과 벽은 서로 살짝 끌어당겨요.", "gap_before": 0.8, "emph": ["가까우면", "끌어당겨요."] },
    { "id": "s6", "text": "털 끝이 수없이 많아서 작은 끌림이 모두 더해져요.", "gap_before": 0.8, "emph": ["수없이", "더해져요."] },
    { "id": "s7", "text": "그래서 모인 끌림이 도마뱀붙이를 벽에 붙들어요.", "gap_before": 1.0, "emph": ["모인", "붙들어요."] }
  ]
}
