{
  "segments": [
    { "id": "s1", "text": "굼구미가 침대에 누워요.", "gap_before": 1.2 },
    { "id": "s2", "text": "누워서는 숨소리가 조용해요.", "gap_before": 0.6 },
    { "id": "s3", "text": "근데 잠들자마자 드르렁 소리가 나요.", "gap_before": 0.5 },
    { "id": "s4", "text": "목 안으로 들어가서 볼게요.", "gap_before": 0.6 },
    { "id": "s5", "text": "잠들면 목 안 근육 힘이 풀려요.", "gap_before": 0.5 },
    { "id": "s6", "text": "늘어진 살이 통로를 좁혀요.", "gap_before": 0.4 },
    { "id": "s7", "text": "좁은 틈으로 공기가 빠르게 지나가요.", "gap_before": 0.4 },
    { "id": "s8", "text": "그 바람이 늘어진 살을 떨리게 해요.", "gap_before": 0.4 },
    { "id": "s9", "text": "다시 방으로 돌아와도 콧소리가 계속돼요.", "gap_before": 0.5 },
    { "id": "s10", "text": "그 떨림이 바로 코 고는 소리예요.", "gap_before": 0.6 }
  ]
}
