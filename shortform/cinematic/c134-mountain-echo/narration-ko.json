{
  "segments": [
    { "id": "s1", "text": "맞은편 산을 보고 야호 하고 외쳐요.", "gap_before": 1.6, "emph": ["야호", "외쳐요"] },
    { "id": "s2", "text": "잠시 뒤 같은 야호가 돌아왔어요.", "gap_before": 2.0, "emph": ["같은", "돌아왔어요"] },
    { "id": "s3", "text": "산이 대답해 주는 게 아니에요.", "gap_before": 0.8, "emph": ["아니에요"] },
    { "id": "s4", "text": "내 목소리는 공기를 타고 사방으로 퍼져요.", "gap_before": 0.8, "emph": ["공기를", "사방으로"] },
    { "id": "s5", "text": "단단한 산에 부딪혀 되튕겨요.", "gap_before": 0.7, "emph": ["단단한", "되튕겨요"] },
    { "id": "s6", "text": "되튕긴 소리가 내게 돌아와요.", "gap_before": 0.7, "emph": ["되튕긴", "돌아와요"] },
    { "id": "s7", "text": "소리는 빛보다 느려서 갔다 오는 데 시간이 걸려요.", "gap_before": 0.8, "emph": ["빛보다", "느려서"] },
    { "id": "s8", "text": "메아리는 산에 부딪혀 늦게 돌아온 내 목소리예요.", "gap_before": 1.0, "emph": ["메아리는", "늦게"] }
  ]
}
