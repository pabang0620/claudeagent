{
  "segments": [
    { "id": "s1", "text": "수도꼭지 물줄기는 아래로 갈수록 가늘어져요.", "gap_before": 1.0, "emph": ["가늘어져요"] },
    { "id": "s2", "text": "물이 줄어서 가늘어지는 게 아니에요.", "gap_before": 0.8, "emph": ["아니에요"] },
    { "id": "s3", "text": "같은 시간에 지나가는 물의 양은 어디서나 같아요.", "gap_before": 0.8, "emph": ["어디서나", "같아요"] },
    { "id": "s4", "text": "중간에 물이 쌓이거나 사라지지 않으니까요.", "gap_before": 0.8, "emph": ["않으니까요"] },
    { "id": "s5", "text": "떨어지는 물은 중력 때문에 점점 빨라져요.", "gap_before": 0.8, "emph": ["중력", "점점"] },
    { "id": "s6", "text": "아래는 빨라서 폭이 좁아도 같은 양이 지나가요.", "gap_before": 0.8, "emph": ["빨라서", "좁아도"] },
    { "id": "s7", "text": "그래서 물줄기는 빨라진 만큼 가늘어져요.", "gap_before": 0.8, "emph": ["빨라진", "가늘어져요"] }
  ]
}
