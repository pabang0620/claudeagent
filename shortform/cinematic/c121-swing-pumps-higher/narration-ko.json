{
  "segments": [
    { "id": "s1", "text": "몸을 가만히 두면 그네는 점점 낮게 흔들려요.", "gap_before": 1.0, "emph": ["가만히", "낮게"] },
    { "id": "s2", "text": "그런데 몸을 움직이자 그네가 높아져요.", "gap_before": 0.7, "emph": ["움직이자", "높아져요"] },
    { "id": "s3", "text": "비밀은 미는 힘만이 아니라 맨 아래에 있어요.", "gap_before": 0.7, "emph": ["아니라", "아래에"] },
    { "id": "s4", "text": "그네는 맨 아래에서 가장 빨라서 몸이 아래로 쏠려요.", "gap_before": 0.7, "emph": ["빨라서", "아래로"] },
    { "id": "s5", "text": "타는 사람이 그 쏠림을 이기고 몸을 끌어올려요.", "gap_before": 0.7, "emph": ["쏠림을", "끌어올려요"] },
    { "id": "s6", "text": "몸을 올리며 쓴 힘이 그네에 에너지로 더해져요.", "gap_before": 0.7, "emph": ["힘이", "에너지로"] },
    { "id": "s7", "text": "끝에서는 거의 멈춰 쏠림이 약해 에너지를 덜 잃어요.", "gap_before": 0.7, "emph": ["멈춰", "약해"] },
    { "id": "s8", "text": "그래서 올리고 내릴 때마다 에너지가 늘어요.", "gap_before": 0.7, "emph": ["올리고", "늘어요"] },
    { "id": "s9", "text": "박자에 맞춘 몸짓이 에너지를 쌓아 그네를 높여요.", "gap_before": 0.7, "emph": ["박자에", "높여요"] }
  ]
}
