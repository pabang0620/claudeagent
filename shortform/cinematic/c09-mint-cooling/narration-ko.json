{
  "segments": [
    { "id": "s1", "text": "박하사탕을 입에 넣자 입안이 화해져요.", "gap_before": 1.2 },
    { "id": "s2", "text": "근데 입속 온도는 하나도 안 바뀌어요.", "gap_before": 0.6 },
    { "id": "s3", "text": "혀에는 찬 걸 알아채는 센서가 있어요.", "gap_before": 0.7 },
    { "id": "s4", "text": "박하 속 멘톨이 그 센서에 달라붙어요.", "gap_before": 0.4 },
    { "id": "s5", "text": "센서가 눌리면 온도 내려갈 때랑 똑같은 신호가 가요.", "gap_before": 0.4 },
    { "id": "s6", "text": "뇌는 신호만 보고 차갑다고 착각해요.", "gap_before": 0.4 },
    { "id": "s7", "text": "다시 보면 온도계는 그대로예요.", "gap_before": 0.6 },
    { "id": "s8", "text": "멘톨이 온도 센서를 직접 눌러서 시원하게 느껴지는 거예요.", "gap_before": 0.5 }
  ]
}
