{
  "segments": [
    { "id": "s1", "text": "한여름 낮에는 햇볕이 쨍쨍 내리쬐어요.", "gap_before": 1.0, "emph": ["한여름", "쨍쨍"] },
    { "id": "s2", "text": "여름이 더운 건 해와 가까워서가 아니에요.", "gap_before": 0.8, "emph": ["가까워서가"] },
    { "id": "s3", "text": "반년 뒤 한국이 겨울일 때 지구는 해와 더 가까워요.", "gap_before": 0.7, "emph": ["겨울일", "더"] },
    { "id": "s4", "text": "원인은 해를 도는 지구가 늘 같은 쪽으로 기운 거예요.", "gap_before": 0.9, "emph": ["같은", "기운"] },
    { "id": "s5", "text": "한국이 해 쪽으로 기울면 해가 높이 떠요.", "gap_before": 0.9, "emph": ["기울면", "높이"] },
    { "id": "s6", "text": "높이 뜬 햇빛은 좁은 땅에 모여 더 뜨거워요.", "gap_before": 0.7, "emph": ["좁은", "뜨거워요"] },
    { "id": "s7", "text": "지구의 기울기 때문에 낮도 길어 오래 데워져요.", "gap_before": 0.7, "emph": ["기울기", "길어"] },
    { "id": "s8", "text": "여름은 지구가 기울어 해가 높고 낮이 길어서 더워요.", "gap_before": 0.9, "emph": ["높고", "길어서"] }
  ]
}
