{
  "segments": [
    { "id": "s1", "text": "굼구미가 추운 곳에서 몸을 떨어요.", "gap_before": 1.2 },
    { "id": "s2", "text": "떨림은 그냥 힘이 빠져서 그런 거라 생각하기 쉬워요.", "gap_before": 0.6 },
    { "id": "s3", "text": "근데 사실 떨림은 몸이 일부러 하는 거예요.", "gap_before": 0.5 },
    { "id": "s4", "text": "몸속으로 들어가서 볼게요.", "gap_before": 0.6 },
    { "id": "s5", "text": "피부의 온도 센서가 뇌에 신호를 보내요.", "gap_before": 0.5 },
    { "id": "s6", "text": "뇌는 근육에 빨리 움직이라고 명령해요.", "gap_before": 0.4 },
    { "id": "s7", "text": "근육이 아주 빠르게 수축과 이완을 반복해요.", "gap_before": 0.4 },
    { "id": "s8", "text": "이 움직임 자체가 몸에 열을 만들어요.", "gap_before": 0.4 },
    { "id": "s9", "text": "이제 떨림 덕분에 몸이 따뜻해져요.", "gap_before": 0.6 },
    { "id": "s10", "text": "뇌가 근육을 움직여서 몸을 스스로 데우는 거예요.", "gap_before": 0.5 }
  ]
}
