{
  "segments": [
    { "id": "s1", "text": "굼구미가 발을 헛디뎌 휘청거려요.", "gap_before": 1.2 },
    { "id": "s2", "text": "당황해서 얼굴이 화끈거려요.", "gap_before": 0.4 },
    { "id": "s3", "text": "몸 전체에 호르몬이 퍼지는데,", "gap_before": 0.3 },
    { "id": "s4", "text": "빨개지는 건 얼굴뿐이에요.", "gap_before": 0.3 },
    { "id": "s5", "text": "부끄러우면 아드레날린 같은 호르몬이 나와요.", "gap_before": 0.7 },
    { "id": "s6", "text": "이 호르몬이 혈관을 넓히거든요.", "gap_before": 0.4 },
    { "id": "s7", "text": "그런데 얼굴은 혈관이 촘촘하고 표면과도 가까워요.", "gap_before": 0.4 },
    { "id": "s8", "text": "그래서 얼굴이 유독 빨갛게 드러나는 거예요.", "gap_before": 0.5 }
  ]
}
