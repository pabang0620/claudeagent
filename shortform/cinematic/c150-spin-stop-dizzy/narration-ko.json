{
  "segments": [
    { "id": "s1", "text": "빙글빙글 돌다 멈추면 세상이 도는 것 같아요.", "gap_before": 1.0, "emph": ["멈추면", "도는"] },
    { "id": "s2", "text": "몸이 아니라 귀 속 액체가 아직 흘러요.", "gap_before": 0.7, "emph": ["아니라", "액체가"] },
    { "id": "s3", "text": "귀 속 관의 감각 털은 휘면 뇌에 회전을 알려요.", "gap_before": 0.8, "emph": ["휘면", "회전을"] },
    { "id": "s4", "text": "관이 돌면 액체는 가만있으려 해서 털이 휘어요.", "gap_before": 0.8, "emph": ["가만있으려", "휘어요."] },
    { "id": "s5", "text": "계속 돌면 액체도 따라 돌아 털이 펴져요.", "gap_before": 0.8, "emph": ["따라", "펴져요."] },
    { "id": "s6", "text": "그러다 멈추면 액체는 계속 흘러 털이 반대로 휘어요.", "gap_before": 0.8, "emph": ["계속", "반대로"] },
    { "id": "s7", "text": "눈은 멈췄다는데 귀는 돈다고 해서 뇌가 헷갈려요.", "gap_before": 0.8, "emph": ["돈다고", "헷갈려요."] },
    { "id": "s8", "text": "그래서 멈춘 뒤에도 귀 속 액체가 흘러 어지러워요.", "gap_before": 1.0, "emph": ["액체가", "어지러워요."] }
  ]
}
