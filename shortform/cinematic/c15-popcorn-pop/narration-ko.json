{
  "segments": [
    { "id": "s1", "text": "굼구미가 냄비에 옥수수를 넣고 불에 올려요.", "gap_before": 1.3 },
    { "id": "s2", "text": "딱딱하고 말라 보이는데 갑자기 뻥 튀어요.", "gap_before": 0.5 },
    { "id": "s3", "text": "전분 속에 작은 물기가 있어요.", "gap_before": 0.8 },
    { "id": "s4", "text": "열을 받으면 물이 수증기로 변해요.", "gap_before": 0.4 },
    { "id": "s5", "text": "수증기가 팽창하려 해서 압력이 세져요.", "gap_before": 0.4 },
    { "id": "s6", "text": "껍질이 버티다가 한계를 넘으면 터져요.", "gap_before": 0.4 },
    { "id": "s7", "text": "터지는 순간 전분이 확 부풀어 올라요.", "gap_before": 0.4 },
    { "id": "s8", "text": "그래서 팝콘이 하얗게 부풀며 터지는 거예요.", "gap_before": 0.6 }
  ]
}
