{
  "segments": [
    { "id": "s1", "text": "양치를 하고 오렌지주스를 마셨더니 갑자기 써요.", "gap_before": 1.2 },
    { "id": "s2", "text": "근데 오렌지주스는 하나도 안 바뀌었어요.", "gap_before": 0.6 },
    { "id": "s3", "text": "치약 거품 성분이 단맛 세포를 잠깐 막아요.", "gap_before": 0.7 },
    { "id": "s4", "text": "쓴맛을 누르던 막도 흐트러져서 더 예민해져요.", "gap_before": 0.4 },
    { "id": "s5", "text": "오렌지주스는 원래 단맛 속에 쓴맛도 숨어 있어요.", "gap_before": 0.4 },
    { "id": "s6", "text": "근데 지금은 단맛은 약하고 쓴맛만 세졌어요.", "gap_before": 0.4 },
    { "id": "s7", "text": "다시 봐도 오렌지주스는 그대로예요.", "gap_before": 0.6 },
    { "id": "s8", "text": "거품 성분 때문에 단맛은 줄고 쓴맛만 세지는 거예요.", "gap_before": 0.5 }
  ]
}
