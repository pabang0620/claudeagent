{
  "segments": [
    { "id": "s1", "text": "굼구미가 옥상에서 볼링공이랑 탁구공을 들어요.", "gap_before": 1.2 },
    { "id": "s2", "text": "이제 동시에 손을 놓을 거예요.", "gap_before": 0.5 },
    { "id": "s3", "text": "무거운 공이 더 빨리 떨어질 것 같아요.", "gap_before": 0.6 },
    { "id": "s4", "text": "무거운 공은 지구가 더 세게 잡아당겨요.", "gap_before": 0.8 },
    { "id": "s5", "text": "근데 무거운 만큼 움직이기도 힘들어요.", "gap_before": 0.5 },
    { "id": "s6", "text": "힘도 저항도 똑같은 비율로 커져요.", "gap_before": 0.5 },
    { "id": "s7", "text": "그래서 무게는 사라지고 빠르기만 남아요.", "gap_before": 0.5 },
    { "id": "s8", "text": "공기 저항만 없다면 둘 다 똑같이 떨어져요.", "gap_before": 1.0 }
  ]
}
