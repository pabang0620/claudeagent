{
  "segments": [
    { "id": "s1", "text": "한낮의 파란 하늘에는 별이 하나도 안 보여요.", "gap_before": 1.0, "emph": ["하나도", "안"] },
    { "id": "s2", "text": "하지만 별이 사라진 게 아니에요.", "gap_before": 0.7, "emph": ["아니에요."] },
    { "id": "s3", "text": "별은 낮에도 하늘에 그대로 있어요.", "gap_before": 0.7, "emph": ["낮에도", "그대로"] },
    { "id": "s4", "text": "낮에는 햇빛이 공기에 흩어져 하늘이 밝아요.", "gap_before": 0.8, "emph": ["흩어져", "밝아요."] },
    { "id": "s5", "text": "밝은 하늘에선 별빛이 하늘빛과 크게 달라야 보여요.", "gap_before": 0.8, "emph": ["크게", "달라야"] },
    { "id": "s6", "text": "별빛은 약해서 하늘빛에 보태는 밝기가 작아요.", "gap_before": 0.8, "emph": ["약해서", "작아요."] },
    { "id": "s7", "text": "해가 지고 하늘빛이 줄면 별빛이 드러나요.", "gap_before": 0.8, "emph": ["줄면", "드러나요."] },
    { "id": "s8", "text": "그래서 별은 하늘이 충분히 어두워져야 보여요.", "gap_before": 1.0, "emph": ["어두워져야", "보여요."] }
  ]
}
