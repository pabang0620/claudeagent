{
  "segments": [
    { "id": "s1", "text": "무더운 날 강아지가 혀를 내밀고 헥헥거려요.", "gap_before": 1.2 },
    { "id": "s2", "text": "근데 몸에는 땀 한 방울도 안 나요.", "gap_before": 0.6 },
    { "id": "s3", "text": "개는 땀샘이 발바닥에만 있어요.", "gap_before": 0.7 },
    { "id": "s4", "text": "그래서 온몸으로는 땀을 못 내요.", "gap_before": 0.4 },
    { "id": "s5", "text": "물이 증발할 때 열도 같이 빠져나가요.", "gap_before": 0.4 },
    { "id": "s6", "text": "그래서 혀랑 입속을 침으로 적셔놔요.", "gap_before": 0.4 },
    { "id": "s7", "text": "그리고 헐떡이며 침을 빠르게 말려요.", "gap_before": 0.3 },
    { "id": "s8", "text": "다시 보면 몸은 그대로 뽀송해요.", "gap_before": 0.6 },
    { "id": "s9", "text": "혀와 입을 적셔서 헐떡이며 열을 날리는 거예요.", "gap_before": 0.5 }
  ]
}
