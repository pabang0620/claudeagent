{
  "segments": [
    { "id": "s1", "text": "소라 껍데기를 귀에 대면 쏴아 소리가 나요.", "gap_before": 1.0, "emph": ["쏴아"] },
    { "id": "s2", "text": "껍데기에 바다 소리가 담긴 게 아니에요.", "gap_before": 0.8, "emph": ["담긴"] },
    { "id": "s3", "text": "빈 컵을 귀에 대도 비슷한 소리가 나요.", "gap_before": 0.7, "emph": ["컵을"] },
    { "id": "s4", "text": "소라도 컵도 방 안의 작은 소리를 듣는 거예요.", "gap_before": 0.7, "emph": ["작은"] },
    { "id": "s5", "text": "소라 속은 비어 있고, 소리가 안으로 들어가요.", "gap_before": 0.8, "emph": ["비어", "안으로"] },
    { "id": "s6", "text": "소리는 안쪽 벽에 부딪히며 오가요.", "gap_before": 0.6, "emph": ["부딪히며"] },
    { "id": "s7", "text": "오가는 소리 중 소라 속 크기에 맞는 소리가 있어요.", "gap_before": 0.7, "emph": ["크기에", "맞는"] },
    { "id": "s8", "text": "맞는 소리는 되돌아온 소리와 겹쳐 커져요.", "gap_before": 0.6, "emph": ["겹쳐", "커져요"] },
    { "id": "s9", "text": "높낮이가 다른 소리가 섞여 쏴아 하고 흘러요.", "gap_before": 0.6, "emph": ["높낮이가", "쏴아"] },
    { "id": "s10", "text": "소라 속이 주변 소리를 키워서 파도처럼 들려요.", "gap_before": 0.7, "emph": ["키워서", "파도처럼"] }
  ]
}
