{
  "segments": [
    { "id": "s1", "text": "굼구미가 바닷가에서 새파란 바다를 바라봐요.", "gap_before": 1.3 },
    { "id": "s2", "text": "그런데 하늘이 흐린 날에도 바다는 푸르스름해요.", "gap_before": 0.5 },
    { "id": "s3", "text": "물은 빛을 색깔마다 다르게 흡수해요.", "gap_before": 0.8 },
    { "id": "s4", "text": "빨간빛은 물에 잘 흡수돼서 금방 사라져요.", "gap_before": 0.4 },
    { "id": "s5", "text": "파란빛은 잘 흡수되지 않고 남아 있어요.", "gap_before": 0.4 },
    { "id": "s6", "text": "그 파란빛이 사방으로 흩어져 나와요.", "gap_before": 0.4 },
    { "id": "s7", "text": "바다가 파란 건 하늘이 아니라 물 때문이에요.", "gap_before": 0.6 }
  ]
}
