{
  "segments": [
    { "id": "s1", "text": "우주정거장 안에서는 연필이 둥둥 떠요.", "gap_before": 1.0, "emph": ["둥둥"] },
    { "id": "s2", "text": "떠 있는 건 중력이 없어서가 아니에요.", "gap_before": 0.8, "emph": ["없어서가", "아니에요"] },
    { "id": "s3", "text": "높은 정거장도 중력이 강해 지구로 계속 떨어져요.", "gap_before": 0.8, "emph": ["강해", "계속"] },
    { "id": "s4", "text": "옆으로 아주 빨리 쏘면 대포알도 땅에 안 닿아요.", "gap_before": 0.8, "emph": ["빨리", "쏘면"] },
    { "id": "s5", "text": "정거장도 떨어진 만큼 둥근 땅이 멀어져 계속 돌아요.", "gap_before": 0.8, "emph": ["만큼", "멀어져"] },
    { "id": "s6", "text": "정거장 안의 연필도 같은 빠르기로 떨어져요.", "gap_before": 0.8, "emph": ["같은", "빠르기로"] },
    { "id": "s7", "text": "함께 떨어지는 바닥은 연필을 받치지 않아요.", "gap_before": 0.8, "emph": ["함께", "받치지"] },
    { "id": "s8", "text": "그래서 함께 떨어지는 연필이 둥둥 떠 보여요.", "gap_before": 0.8, "emph": ["함께", "둥둥"] }
  ]
}
