{
  "segments": [
    { "id": "s1", "text": "비둘기는 걸을 때마다 머리를 까딱거려요.", "gap_before": 1.2, "emph": ["까딱거려요"] },
    { "id": "s2", "text": "고개 인사나 습관이 아니에요.", "gap_before": 0.7, "emph": ["습관이"] },
    { "id": "s3", "text": "머리를 앞으로 휙 보낸 뒤 그 자리에 멈춰요.", "gap_before": 1.0, "emph": ["휙", "멈춰요"] },
    { "id": "s4", "text": "그동안 몸이 걸어서 머리 쪽으로 따라와요.", "gap_before": 0.5, "emph": ["몸이", "따라와요"] },
    { "id": "s5", "text": "멈추는 이유는 눈이에요. 눈동자를 많이 못 굴려요.", "gap_before": 0.9, "emph": ["눈이에요", "많이"] },
    { "id": "s6", "text": "눈이 못 따라가서 머리가 움직이면 풍경이 번져요.", "gap_before": 0.9, "emph": ["못", "번져요"] },
    { "id": "s7", "text": "머리를 멈추면 풍경도 멈춰 또렷하게 보여요.", "gap_before": 0.7, "emph": ["멈추면", "또렷하게"] },
    { "id": "s8", "text": "까딱임은 풍경을 또렷이 보려고 머리를 멈추는 거예요.", "gap_before": 0.9, "emph": ["또렷이", "멈추는"] }
  ]
}
