{
  "segments": [
    { "id": "s1", "text": "비 그친 숲 바닥을 걸어요.", "gap_before": 1.0, "emph": ["그친"] },
    { "id": "s2", "text": "어제 없던 버섯이 쑥쑥 솟았어요.", "gap_before": 0.8, "emph": ["쑥쑥"] },
    { "id": "s3", "text": "비가 버섯을 만든 건 아니에요.", "gap_before": 0.7, "emph": ["만든", "아니에요"] },
    { "id": "s4", "text": "땅속엔 실 같은 균사가 퍼져 있어요.", "gap_before": 0.7, "emph": ["균사가"] },
    { "id": "s5", "text": "균사가 모여 작은 버섯을 미리 만들어요.", "gap_before": 0.7, "emph": ["미리"] },
    { "id": "s6", "text": "비가 오면 균사가 물을 모아 버섯에 보내요.", "gap_before": 0.8, "emph": ["물을"] },
    { "id": "s7", "text": "받은 물로 이미 있던 세포가 부풀어요.", "gap_before": 0.7, "emph": ["이미", "부풀어요"] },
    { "id": "s8", "text": "그래서 작은 버섯이 밤새 쑥 솟아요.", "gap_before": 0.9, "emph": ["밤새", "솟아요"] }
  ]
}
