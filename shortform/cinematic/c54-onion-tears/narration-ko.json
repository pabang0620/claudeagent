{
  "segments": [
    { "id": "s1", "text": "굼구미가 양파를 썰자 눈물이 나요.", "gap_before": 1.2 },
    { "id": "s2", "text": "그런데 통째인 양파 앞에선 굼구미가 멀쩡해요.", "gap_before": 0.6 },
    { "id": "s3", "text": "양파 속 작은 방마다 두 성분이 따로 있어요.", "gap_before": 1.0 },
    { "id": "s4", "text": "칼에 썰리면 방이 터져서 두 성분이 섞여요.", "gap_before": 0.5 },
    { "id": "s5", "text": "섞이면 눈을 따갑게 하는 기체가 생겨요.", "gap_before": 0.5 },
    { "id": "s6", "text": "그 기체가 공기를 타고 눈까지 와요.", "gap_before": 0.9 },
    { "id": "s7", "text": "양파 기체에 눈이 따가워서 눈물이 나요.", "gap_before": 0.6 }
  ]
}
