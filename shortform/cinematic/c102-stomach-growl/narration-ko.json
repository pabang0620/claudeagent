{
  "segments": [
    { "id": "s1", "text": "조용한 교실에서 굼구미 배가 꼬르륵 울려요.", "gap_before": 1.0, "emph": ["꼬르륵"] },
    { "id": "s2", "text": "굶주린 배가 우는 소리가 아니에요.", "gap_before": 0.6, "emph": ["굶주린"] },
    { "id": "s3", "text": "위와 장 안에는 공기와 물이 들어 있어요.", "gap_before": 0.8, "emph": ["공기와", "물이"] },
    { "id": "s4", "text": "위와 장 근육이 오므라들며 속의 것을 밀어내요.", "gap_before": 0.7, "emph": ["오므라들며"] },
    { "id": "s5", "text": "그러면 공기와 물이 좁은 틈으로 밀려가요.", "gap_before": 0.7, "emph": ["좁은", "틈으로"] },
    { "id": "s6", "text": "공기와 물이 밀려가며 출렁이는 소리가 꼬르륵이에요.", "gap_before": 0.7, "emph": ["출렁이는"] },
    { "id": "s7", "text": "음식이 있으면 소리가 덜 들리고, 비면 잘 들려요.", "gap_before": 0.8, "emph": ["덜", "비면"] },
    { "id": "s8", "text": "꼬르륵은 배 속 공기와 물이 내는 소리예요.", "gap_before": 0.9, "emph": ["공기와", "물이"] }
  ]
}
