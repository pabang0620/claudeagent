{
  "segments": [
    { "id": "s1", "text": "진흙탕 웅덩이가 햇볕에 말라가요.", "gap_before": 1.0, "emph": ["진흙탕"] },
    { "id": "s2", "text": "마른 자리에 거북 등 같은 틈이 생겨요.", "gap_before": 0.8, "emph": ["틈이"] },
    { "id": "s3", "text": "흙이 말라서 부서지는 게 아니에요.", "gap_before": 0.7, "emph": ["부서지는"] },
    { "id": "s4", "text": "진흙은 물이 빠지면 줄어들어요.", "gap_before": 0.9, "emph": ["물이", "빠지면"] },
    { "id": "s5", "text": "햇볕에 닿은 표면부터 먼저 말라서 줄어요.", "gap_before": 0.7, "emph": ["표면부터", "먼저"] },
    { "id": "s6", "text": "젖은 아래는 안 줄고 붙어서 표면이 당겨져요.", "gap_before": 0.7, "emph": ["안", "붙어서"] },
    { "id": "s7", "text": "당기는 힘이 흙이 버티는 힘을 넘으면 갈라져요.", "gap_before": 0.7, "emph": ["버티는", "넘으면"] },
    { "id": "s8", "text": "틈이 퍼져 서로 이어지면 조각이 나뉘어요.", "gap_before": 0.9, "emph": ["이어지면", "조각이"] },
    { "id": "s9", "text": "마르며 줄어드는 진흙 표면이 당겨져 갈라져요.", "gap_before": 0.9, "emph": ["줄어드는", "당겨져"] }
  ]
}
