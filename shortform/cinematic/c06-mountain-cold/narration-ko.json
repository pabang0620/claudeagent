{
  "segments": [
    { "id": "s1", "text": "굼구미가 무더운 여름날 산을 올라요.", "gap_before": 1.2 },
    { "id": "s2", "text": "산 위로 갈수록 해와 더 가까워지잖아요.", "gap_before": 0.6 },
    { "id": "s3", "text": "근데 정상에선 오히려 더 춥거든요.", "gap_before": 0.5 },
    { "id": "s4", "text": "공기는 투명해서 햇빛을 그냥 통과시켜요.", "gap_before": 0.6 },
    { "id": "s5", "text": "땅에 닿은 빛이 땅을 데우고 위 공기를 데워요.", "gap_before": 0.4 },
    { "id": "s6", "text": "위로 갈수록 기압이 낮아져 공기가 부풀면서 식어요.", "gap_before": 0.4 },
    { "id": "s7", "text": "이걸 단열 냉각이라고 해요.", "gap_before": 0.5 },
    { "id": "s8", "text": "그래서 산은 해와 가까워도 오히려 더 추운 거예요.", "gap_before": 0.6 }
  ]
}
