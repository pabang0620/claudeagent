{
  "segments": [
    { "id": "s1", "text": "별 모양 눈송이를 확대해 보면 갈래가 여섯 개예요.", "gap_before": 1.2, "emph": ["갈래가", "여섯"] },
    { "id": "s2", "text": "눈송이는 빗방울이 얼어서 생긴 게 아니에요.", "gap_before": 0.7, "emph": ["얼어서", "아니에요."] },
    { "id": "s3", "text": "구름 속 수증기가 작은 얼음에 얼어붙어 자라요.", "gap_before": 1.2, "emph": ["수증기가", "얼어붙어"] },
    { "id": "s4", "text": "얼음은 물 분자가 육각형으로 줄을 서서 굳어요.", "gap_before": 0.8, "emph": ["육각형으로", "굳어요."] },
    { "id": "s5", "text": "그래서 작은 얼음은 육각형 판이 돼요.", "gap_before": 0.8, "emph": ["육각형", "판이"] },
    { "id": "s6", "text": "여섯 모서리는 튀어나와서 수증기가 먼저 닿아요.", "gap_before": 0.8, "emph": ["튀어나와서", "먼저"] },
    { "id": "s7", "text": "더 많이 닿는 모서리가 빨리 자라 갈래가 돼요.", "gap_before": 0.8, "emph": ["많이", "빨리"] },
    { "id": "s8", "text": "그래서 눈송이는 여섯 모서리가 자라 갈래가 돼요.", "gap_before": 1.0, "emph": ["모서리가", "갈래가"] }
  ]
}
