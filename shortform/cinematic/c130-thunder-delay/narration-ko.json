{
  "segments": [
    { "id": "s1", "text": "창밖에 번개가 번쩍하면 한참 뒤에 쾅 소리가 나요.", "gap_before": 1.0, "emph": ["번쩍하면", "한참"] },
    { "id": "s2", "text": "천둥이 늦게 생기는 게 아니에요.", "gap_before": 0.8, "emph": ["아니에요"] },
    { "id": "s3", "text": "번개가 칠 때, 공기가 확 달궈져 부풀며 쾅 울려요.", "gap_before": 0.8, "emph": ["달궈져", "쾅"] },
    { "id": "s4", "text": "번개 빛은 거의 곧바로 우리 눈에 닿아요.", "gap_before": 1.0, "emph": ["빛은", "곧바로"] },
    { "id": "s5", "text": "같은 번개의 소리는 훨씬 느려서 천천히 와요.", "gap_before": 0.6, "emph": ["느려서", "천천히"] },
    { "id": "s6", "text": "번개가 멀면 소리가 갈 거리가 길어져 늦어요.", "gap_before": 0.8, "emph": ["멀면", "길어져"] },
    { "id": "s7", "text": "그래서 번개가 먼 만큼 천둥이 늦게 들려요.", "gap_before": 1.0, "emph": ["먼", "늦게"] }
  ]
}
