{
  "segments": [
    { "id": "s1", "text": "슬픈 영화를 보면 눈물과 콧물이 나요.", "gap_before": 1.0, "emph": ["눈물과", "콧물이"] },
    { "id": "s2", "text": "콧물이 코에서만 나오는 게 아니에요.", "gap_before": 1.0, "emph": ["코에서만"] },
    { "id": "s3", "text": "눈 안쪽 구석에 눈물이 빠지는 구멍이 있어요.", "gap_before": 0.7, "emph": ["구멍이"] },
    { "id": "s4", "text": "이 구멍은 가는 관을 따라 코 안으로 이어져요.", "gap_before": 0.7, "emph": ["관을", "이어져요"] },
    { "id": "s5", "text": "울면 눈물이 많아서 관으로 흘러드는 양도 늘어요.", "gap_before": 0.7, "emph": ["많아서", "늘어요"] },
    { "id": "s6", "text": "코 안에 흘러든 눈물이 콧물과 섞여 나와요.", "gap_before": 0.7, "emph": ["섞여"] },
    { "id": "s7", "text": "눈과 코는 눈물이 지나는 관으로 이어져 있어요.", "gap_before": 0.9, "emph": ["이어져"] }
  ]
}
