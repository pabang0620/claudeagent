{
  "segments": [
    { "id": "s1", "text": "책상 모서리에 쾅 부딪혔더니 멍이 들었어요.", "gap_before": 1.2, "emph": ["쾅", "멍이"] },
    { "id": "s2", "text": "멍은 피부 겉에 칠해진 색이 아니에요.", "gap_before": 0.7, "emph": ["아니에요."] },
    { "id": "s3", "text": "충격에 눌려 피부 밑 얇은 핏줄이 터져요.", "gap_before": 1.4, "emph": ["눌려", "터져요."] },
    { "id": "s4", "text": "터진 틈으로 피가 주변 살로 새어 들어요.", "gap_before": 0.8, "emph": ["새어", "들어요."] },
    { "id": "s5", "text": "피부가 멀쩡해서 피가 밖으로 못 나가고 고여요.", "gap_before": 0.8, "emph": ["못", "고여요."] },
    { "id": "s6", "text": "고인 피가 피부 너머로 비쳐 보여요.", "gap_before": 0.8, "emph": ["비쳐", "보여요."] },
    { "id": "s7", "text": "그래서 멍은 피부 밑에 새어 고인 피예요.", "gap_before": 1.0, "emph": ["고인", "피예요."] }
  ]
}
