{
  "segments": [
    { "id": "s1", "text": "스위치를 누르면 꼬마전구가 바로 켜져요.", "gap_before": 1.0, "emph": ["바로"] },
    { "id": "s2", "text": "전선이 길게 늘어져 있어도 그래요.", "gap_before": 0.8, "emph": ["길게"] },
    { "id": "s3", "text": "전자가 건전지에서 달려와 켜는 게 아니에요.", "gap_before": 0.7, "emph": ["달려와"] },
    { "id": "s4", "text": "전자는 전선 속에 처음부터 가득한 알갱이예요.", "gap_before": 0.9, "emph": ["처음부터", "가득한"] },
    { "id": "s5", "text": "건전지가 밀면 전자들이 모두 같이 움직여요.", "gap_before": 0.7, "emph": ["밀면", "같이"] },
    { "id": "s6", "text": "그래서 멀리 있는 전구 속 전자도 바로 움직여요.", "gap_before": 0.7, "emph": ["멀리", "바로"] },
    { "id": "s7", "text": "전구 속 가는 선은 전자가 부딪혀 달아올라 빛나요.", "gap_before": 0.7, "emph": ["부딪혀", "달아올라"] },
    { "id": "s8", "text": "전선 속 전자가 한꺼번에 움직여 전구가 바로 켜져요.", "gap_before": 0.9, "emph": ["한꺼번에", "바로"] }
  ]
}
