{
  "segments": [
    { "id": "s1", "text": "얼음을 넣으면 물 위에 동동 떠요.", "gap_before": 1.2 },
    { "id": "s2", "text": "대부분의 물질은 고체가 되면 가라앉거든요.", "gap_before": 0.6 },
    { "id": "s3", "text": "물이 얼면 분자들이 육각형으로 줄을 서요.", "gap_before": 0.9 },
    { "id": "s4", "text": "가운데가 비어서 자리를 넓게 차지해요.", "gap_before": 0.4 },
    { "id": "s5", "text": "자리를 넓게 차지하면 가벼워지고요.", "gap_before": 0.4 },
    { "id": "s6", "text": "가벼운 건 물 위로 뜨는 거예요.", "gap_before": 0.4 },
    { "id": "s7", "text": "그래서 얼음도 빈틈 때문에 물에 뜨는 거예요.", "gap_before": 0.6 }
  ]
}
