{
  "segments": [
    { "id": "s1", "text": "우주에 둥둥 떠서 해를 바라봐요.", "gap_before": 1.3 },
    { "id": "s2", "text": "근데 바로 옆 하늘은 새까매요.", "gap_before": 0.6 },
    { "id": "s3", "text": "햇빛이 공기 알갱이에 부딪혀 사방으로 흩어져요.", "gap_before": 1.0 },
    { "id": "s4", "text": "그래서 지구 하늘은 낮에 온통 밝은 거예요.", "gap_before": 0.4 },
    { "id": "s5", "text": "근데 우주에는 이 공기가 없어요.", "gap_before": 0.9 },
    { "id": "s6", "text": "그래서 흩어질 게 없어서 빛이 그대로 나아가요.", "gap_before": 0.4 },
    { "id": "s7", "text": "그래서 태양 쪽만 밝고 나머지는 새까맣게 남아요.", "gap_before": 0.8 }
  ]
}
