{
  "segments": [
    { "id": "s1", "text": "굼구미가 공원 벤치에 앉아요.", "gap_before": 1.2 },
    { "id": "s2", "text": "온도계로 재면 팔걸이도 등받이도 똑같아요.", "gap_before": 0.6 },
    { "id": "s3", "text": "근데 쇠를 만지면 훨씬 차갑게 느껴져요.", "gap_before": 0.5 },
    { "id": "s4", "text": "피부 속을 확대해서 볼게요.", "gap_before": 0.6 },
    { "id": "s5", "text": "피부는 온도 대신 열 빠지는 속도를 느껴요.", "gap_before": 0.5 },
    { "id": "s6", "text": "쇠는 열을 빨리 전달해서 손 열을 확 뺏어가요.", "gap_before": 0.4 },
    { "id": "s7", "text": "나무는 열을 천천히 전달해서 조금만 가져가요.", "gap_before": 0.4 },
    { "id": "s8", "text": "그래서 쇠 닿은 피부 온도가 훅 떨어져요.", "gap_before": 0.4 },
    { "id": "s9", "text": "이런 차이를 열전도율이라고 해요.", "gap_before": 0.5 },
    { "id": "s10", "text": "다시 벤치로 돌아와도 쇠 쪽만 차가워요.", "gap_before": 0.5 },
    { "id": "s11", "text": "온도가 같아도 열 뺏기는 속도가 다르면 차갑게 느껴져요.", "gap_before": 0.6 }
  ]
}
