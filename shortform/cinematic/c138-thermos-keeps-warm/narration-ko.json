{
  "segments": [
    { "id": "s1", "text": "저녁에 뜨거운 물을 컵과 보온병에 담았어요.", "gap_before": 1.0, "emph": ["뜨거운", "담았어요"] },
    { "id": "s2", "text": "아침엔 컵 물은 식었고 보온병 물은 따뜻해요.", "gap_before": 0.7, "emph": ["식었고", "따뜻해요"] },
    { "id": "s3", "text": "보온병 물이 따뜻한 건 솜 때문이 아니에요.", "gap_before": 0.7, "emph": ["아니에요"] },
    { "id": "s4", "text": "보온병은 두 겹 벽 사이 공기를 뽑아 비웠어요.", "gap_before": 0.7, "emph": ["공기를", "비웠어요"] },
    { "id": "s5", "text": "뜨거운 알갱이가 옆 알갱이에 부딪혀 열을 넘겨요.", "gap_before": 0.7, "emph": ["부딪혀", "넘겨요"] },
    { "id": "s6", "text": "빈틈엔 알갱이가 없어 열이 거의 못 건너요.", "gap_before": 0.7, "emph": ["없어", "못"] },
    { "id": "s7", "text": "그래도 열은 눈에 안 보이는 빛으로도 퍼져요.", "gap_before": 0.7, "emph": ["빛으로도", "퍼져요"] },
    { "id": "s8", "text": "거울처럼 반짝이는 벽이 그 빛을 되돌려요.", "gap_before": 0.7, "emph": ["반짝이는", "되돌려요"] },
    { "id": "s9", "text": "그래서 열이 천천히 빠져나가 물이 오래 따뜻해요.", "gap_before": 0.9, "emph": ["천천히", "오래"] }
  ]
}
