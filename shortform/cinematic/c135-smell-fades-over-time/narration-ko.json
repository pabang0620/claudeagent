{
  "segments": [
    { "id": "s1", "text": "빵집에 한참 있으면 빵 냄새가 안 나요.", "gap_before": 1.0, "emph": ["한참", "안"] },
    { "id": "s2", "text": "냄새가 사라진 게 아니에요.", "gap_before": 0.8, "emph": ["아니에요"] },
    { "id": "s3", "text": "그럼 냄새는 공기 속 작은 알갱이예요.", "gap_before": 0.8, "emph": ["작은", "알갱이예요"] },
    { "id": "s4", "text": "코 속 위쪽에 냄새 세포가 있어요.", "gap_before": 0.8, "emph": ["위쪽에", "세포가"] },
    { "id": "s5", "text": "알갱이가 닿으면 세포가 신호를 보내요.", "gap_before": 0.8, "emph": ["닿으면", "신호를"] },
    { "id": "s6", "text": "신호는 뇌로 가서 냄새로 느껴져요.", "gap_before": 0.7, "emph": ["뇌로", "느껴져요"] },
    { "id": "s7", "text": "냄새가 계속되면 세포가 반응을 줄이기도 해요.", "gap_before": 0.8, "emph": ["계속되면", "줄이기도"] },
    { "id": "s8", "text": "그래서 뇌로 가는 신호가 줄어 덜 알아채요.", "gap_before": 0.7, "emph": ["줄어", "덜"] },
    { "id": "s9", "text": "냄새는 그대로인데 신호가 줄어서 덜 느끼는 거예요.", "gap_before": 1.0, "emph": ["그대로인데", "줄어서"] }
  ]
}
