{
  "segments": [
    { "id": "s1", "text": "입으로 분 고무풍선이 방에 매달려 있어요.", "gap_before": 1.0, "emph": ["고무풍선이"] },
    { "id": "s2", "text": "다음 날 풍선이 작고 쭈글쭈글해졌어요.", "gap_before": 0.8, "emph": ["작고"] },
    { "id": "s3", "text": "구멍이 뚫려서 새는 게 아니에요.", "gap_before": 0.7, "emph": ["구멍이", "뚫려서"] },
    { "id": "s4", "text": "고무 속에는 눈에 안 보이는 틈이 있어요.", "gap_before": 0.9, "emph": ["안", "틈이"] },
    { "id": "s5", "text": "공기 알갱이는 계속 움직여서 틈으로 나가요.", "gap_before": 0.7, "emph": ["움직여서", "틈으로"] },
    { "id": "s6", "text": "밖보다 풍선 안이 빽빽해서 나가는 알갱이가 많아요.", "gap_before": 0.7, "emph": ["빽빽해서", "나가는"] },
    { "id": "s7", "text": "안쪽 공기가 줄면 고무를 미는 힘이 약해져요.", "gap_before": 0.7, "emph": ["줄면", "미는"] },
    { "id": "s8", "text": "그러면 늘어났던 고무가 도로 오그라들어요.", "gap_before": 0.6, "emph": ["늘어났던", "도로"] },
    { "id": "s9", "text": "공기가 고무 틈으로 빠져 풍선이 쪼그라들어요.", "gap_before": 0.9, "emph": ["틈으로", "빠져"] }
  ]
}
