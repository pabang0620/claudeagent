{
  "segments": [
    { "id": "s1", "text": "굼구미가 물웅덩이에 발을 담갔어요.", "gap_before": 1.2 },
    { "id": "s2", "text": "근데 다리가 이상하게 짧아 보여요.", "gap_before": 0.5 },
    { "id": "s3", "text": "사실 다리 길이는 그대로예요.", "gap_before": 0.5 },
    { "id": "s4", "text": "수면 옆에서 자세히 볼게요.", "gap_before": 0.7 },
    { "id": "s5", "text": "빛은 물과 공기에서 속도가 달라요.", "gap_before": 0.4 },
    { "id": "s6", "text": "그 경계에서 빛의 방향이 살짝 꺾여요.", "gap_before": 0.4 },
    { "id": "s7", "text": "그 빛은 실제보다 위쪽에서 오는 듯 보여요.", "gap_before": 0.4 },
    { "id": "s8", "text": "눈과 뇌는 빛이 늘 일직선으로 온다고 믿어요.", "gap_before": 0.4 },
    { "id": "s9", "text": "물컵 속 빨대도 똑같이 꺾여 보여요.", "gap_before": 0.6 },
    { "id": "s10", "text": "그래서 다리가 짧고 위로 들려 보이는 거예요.", "gap_before": 0.4 }
  ]
}
