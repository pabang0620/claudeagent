{
  "segments": [
    { "id": "s1", "text": "구멍에 들어가는 다른 열쇠도 돌아가지 않아요.", "gap_before": 1.0, "emph": ["들어가는", "않아요."] },
    { "id": "s2", "text": "구멍 모양만 맞는다고 여는 게 아니에요.", "gap_before": 0.7, "emph": ["아니에요."] },
    { "id": "s3", "text": "흔한 열쇠 자물쇠의 비밀은 속에 있는 핀이에요.", "gap_before": 0.7, "emph": ["속에", "핀이에요."] },
    { "id": "s4", "text": "눌린 핀이 몸통과 돌아가는 속통에 걸쳐 막아요.", "gap_before": 0.8, "emph": ["걸쳐", "막아요."] },
    { "id": "s5", "text": "열쇠를 넣으면 톱니 높이대로 핀이 밀려 올라가요.", "gap_before": 0.8, "emph": ["높이대로", "올라가요."] },
    { "id": "s6", "text": "다른 열쇠는 핀 하나가 속통 끝선에 걸려 멈춰요.", "gap_before": 0.8, "emph": ["하나가", "멈춰요."] },
    { "id": "s7", "text": "맞는 열쇠는 핀 틈을 끝선에 모아서 속통이 돌아요.", "gap_before": 0.8, "emph": ["모아서", "돌아요."] },
    { "id": "s8", "text": "열쇠마다 톱니 높이가 달라서 맞는 열쇠만 열려요.", "gap_before": 1.0, "emph": ["달라서", "열려요."] }
  ]
}
