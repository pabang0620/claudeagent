{
  "segments": [
    { "id": "s1", "text": "밤하늘에 별똥별이 줄을 그으며 떨어져요.", "gap_before": 1.2, "emph": ["별똥별이"] },
    { "id": "s2", "text": "그런데 별똥별은 별이 아니에요.", "gap_before": 0.6, "emph": ["별똥별은", "별이"] },
    { "id": "s3", "text": "정체는 우주를 떠다니던 모래알 같은 알갱이예요.", "gap_before": 0.7, "emph": ["우주를", "모래알"] },
    { "id": "s4", "text": "알갱이가 아주 빠르게 지구의 공기에 뛰어들어요.", "gap_before": 0.7, "emph": ["빠르게", "공기에"] },
    { "id": "s5", "text": "알갱이가 밀어 앞의 공기가 순식간에 눌려 뜨거워져요.", "gap_before": 0.7, "emph": ["순식간에", "눌려"] },
    { "id": "s6", "text": "뜨거워진 공기와 알갱이가 빛을 내요.", "gap_before": 0.7, "emph": ["뜨거워진", "빛을"] },
    { "id": "s7", "text": "알갱이는 대부분 땅에 닿기 전에 다 타요.", "gap_before": 0.7, "emph": ["대부분", "전에"] },
    { "id": "s8", "text": "별똥별은 우주 알갱이가 공기에 타며 내는 빛이에요.", "gap_before": 0.8, "emph": ["알갱이가", "타며"] }
  ]
}
