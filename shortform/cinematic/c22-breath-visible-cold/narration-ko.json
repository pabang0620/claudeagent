{
  "segments": [
    { "id": "s1", "text": "굼구미가 추운 마당에 서서 숨을 내쉬어요.", "gap_before": 1.2 },
    { "id": "s2", "text": "따뜻한 방 안에서도 숨에는 수증기가 있어요.", "gap_before": 0.6 },
    { "id": "s3", "text": "그런데 이상하게 밖에서만 하얗게 보여요.", "gap_before": 0.5 },
    { "id": "s4", "text": "숨 속을 확대해서 볼게요.", "gap_before": 0.6 },
    { "id": "s5", "text": "숨은 몸속에서 데워지며 수증기를 머금어요.", "gap_before": 0.5 },
    { "id": "s6", "text": "이 숨이 차가운 공기를 만나면 순식간에 식어요.", "gap_before": 0.4 },
    { "id": "s7", "text": "식은 공기는 수증기를 다 못 담아 물방울로 맺혀요.", "gap_before": 0.4 },
    { "id": "s8", "text": "물방울들이 빛을 사방으로 흩어서 하얗게 보여요.", "gap_before": 0.4 },
    { "id": "s9", "text": "다시 마당으로 돌아와도 입김은 여전히 하얘요.", "gap_before": 0.5 },
    { "id": "s10", "text": "따뜻한 숨이 식어 물방울 되면 하얗게 보여요.", "gap_before": 0.6 }
  ]
}
