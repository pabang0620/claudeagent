{
  "segments": [
    { "id": "s1", "text": "찬 유리컵에 뜨거운 물을 부으면 금이 가기도 해요.", "gap_before": 1.2, "emph": ["뜨거운", "금이"] },
    { "id": "s2", "text": "물이 뜨거워서 유리가 약해지는 게 아니에요.", "gap_before": 0.8, "emph": ["약해지는"] },
    { "id": "s3", "text": "유리는 데워지면 조금 늘어나요.", "gap_before": 0.9, "emph": ["데워지면", "늘어나요"] },
    { "id": "s4", "text": "뜨거운 물이 닿은 안쪽 면만 먼저 늘어나요.", "gap_before": 0.7, "emph": ["안쪽", "먼저"] },
    { "id": "s5", "text": "유리는 열이 느리게 전해져서 바깥은 아직 차가워요.", "gap_before": 0.8, "emph": ["느리게", "차가워요"] },
    { "id": "s6", "text": "안팎이 붙어 있어서 늘어난 안쪽이 바깥을 당겨요.", "gap_before": 0.8, "emph": ["붙어", "당겨요"] },
    { "id": "s7", "text": "유리는 당기는 힘에 약해서 금이 가요.", "gap_before": 0.7, "emph": ["당기는", "금이"] },
    { "id": "s8", "text": "그래서 안과 밖 온도 차가 클수록 잘 깨져요.", "gap_before": 0.8, "emph": ["온도", "깨져요"] }
  ]
}
