{
  "segments": [
    { "id": "s1", "text": "단풍나무 씨앗이 빙글빙글 돌며 내려와요.", "gap_before": 1.0, "emph": ["빙글빙글", "내려와요"] },
    { "id": "s2", "text": "바람이 없어도 씨앗은 혼자 돌아요.", "gap_before": 0.8, "emph": ["없어도", "혼자"] },
    { "id": "s3", "text": "바람이 돌리는 게 아니에요.", "gap_before": 0.5, "emph": ["아니에요"] },
    { "id": "s4", "text": "씨앗 쪽이 날개 쪽보다 무거워요.", "gap_before": 0.8, "emph": ["쪽보다", "무거워요"] },
    { "id": "s5", "text": "그래서 떨어지는 날개가 공기에 밀려 돌아요.", "gap_before": 0.8, "emph": ["떨어지는", "밀려"] },
    { "id": "s6", "text": "돌아가는 날개는 공기를 아래로 밀어 내요.", "gap_before": 0.8, "emph": ["아래로", "밀어"] },
    { "id": "s7", "text": "그러면 공기가 위로 씨앗을 조금 받쳐 줘요.", "gap_before": 0.8, "emph": ["위로", "받쳐"] },
    { "id": "s8", "text": "그래서 단풍 씨앗은 보통 씨앗보다 천천히 떨어져요.", "gap_before": 1.0, "emph": ["씨앗보다", "천천히"] }
  ]
}
