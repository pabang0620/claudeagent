{
  "segments": [
    { "id": "s1", "text": "엘리베이터가 출발할 때 몸이 무겁게 느껴져요.", "gap_before": 1.0, "emph": ["출발할", "무겁게"] },
    { "id": "s2", "text": "출발해 빨라질 때 체중계 눈금도 커져요.", "gap_before": 0.8, "emph": ["빨라질", "커져요"] },
    { "id": "s3", "text": "중력이 세진 게 아니라 그대로예요.", "gap_before": 0.7, "emph": ["아니라", "그대로예요"] },
    { "id": "s4", "text": "엘리베이터가 출발하면 몸도 위로 빨라져야 해요.", "gap_before": 0.8, "emph": ["출발하면", "빨라져야"] },
    { "id": "s5", "text": "몸이 빨라지려면 중력보다 센 힘이 위로 필요해요.", "gap_before": 0.9, "emph": ["중력보다", "필요해요"] },
    { "id": "s6", "text": "그 힘은 바닥이 발을 밀어 올려서 생겨요.", "gap_before": 0.8, "emph": ["바닥이", "밀어"] },
    { "id": "s7", "text": "그래서 발이 꾹 눌려 눈금이 커지고 무겁게 느껴져요.", "gap_before": 0.8, "emph": ["눌려", "눈금이"] },
    { "id": "s8", "text": "엘리베이터가 일정하게 오르면 눈금은 원래대로예요.", "gap_before": 1.0, "emph": ["일정하게", "원래대로예요"] }
  ]
}
