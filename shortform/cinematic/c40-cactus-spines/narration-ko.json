{
  "segments": [
    { "id": "s1", "text": "선인장을 만졌다가 가시에 콕 찔려요.", "gap_before": 1.2 },
    { "id": "s2", "text": "근데 선인장에는 잎이 따로 없어요.", "gap_before": 0.6 },
    { "id": "s3", "text": "잎이 넓으면 물 빠지는 구멍도 많아요.", "gap_before": 0.7 },
    { "id": "s4", "text": "그런데 사막엔 비가 아주 적게 와요.", "gap_before": 0.4 },
    { "id": "s5", "text": "그래서 잎을 가늘고 뾰족한 가시로 줄였어요.", "gap_before": 0.4 },
    { "id": "s6", "text": "대신 통통한 줄기가 광합성도 하고 물도 저장해요.", "gap_before": 0.4 },
    { "id": "s7", "text": "다시 보면 방금 그 가시가 잎이었어요.", "gap_before": 0.6 },
    { "id": "s8", "text": "가시는 물을 아끼려고 잎이 모습을 바꾼 거예요.", "gap_before": 0.5 }
  ]
}
