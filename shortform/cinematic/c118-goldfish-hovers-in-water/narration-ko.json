{
  "segments": [
    { "id": "s1", "text": "금붕어가 어항 한가운데 가만히 떠 있어요.", "gap_before": 1.0, "emph": ["가만히"] },
    { "id": "s2", "text": "금붕어는 지느러미를 계속 저어서 뜨는 게 아니에요.", "gap_before": 0.8, "emph": ["저어서"] },
    { "id": "s3", "text": "금붕어 몸은 뼈와 근육 때문에 물보다 무거워요.", "gap_before": 0.7, "emph": ["무거워요", "근육"] },
    { "id": "s4", "text": "금붕어는 부레 속 가스로 가라앉는 걸 막아요.", "gap_before": 0.7, "emph": ["부레", "가라앉는"] },
    { "id": "s5", "text": "가스는 가벼워서 같은 크기 물과 무게가 비슷해져요.", "gap_before": 0.8, "emph": ["가벼워서", "비슷해져요"] },
    { "id": "s6", "text": "그러면 물이 위로 미는 힘이 몸무게와 거의 같아요.", "gap_before": 0.7, "emph": ["미는", "같아요"] },
    { "id": "s7", "text": "그래서 부레 가스 덕에 금붕어는 가만히 떠 있어요.", "gap_before": 0.9, "emph": ["부레", "가만히"] }
  ]
}
