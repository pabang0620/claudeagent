{
  "segments": [
    { "id": "s1", "text": "굼구미가 볕 좋은 마당에 누워 있어요.", "gap_before": 1.2 },
    { "id": "s2", "text": "한참 있었더니 피부색이 변했어요.", "gap_before": 0.4 },
    { "id": "s3", "text": "그냥 상처인 줄 알았는데, 사실 몸이 막아내는 거예요.", "gap_before": 0.5 },
    { "id": "s4", "text": "자외선이 세포 속까지 파고들어 상처를 남겨요.", "gap_before": 0.8 },
    { "id": "s5", "text": "피부는 막아내려고 색소를 더 만들어요.", "gap_before": 0.4 },
    { "id": "s6", "text": "색소가 세포핵 위를 덮어 자외선을 막아줘요.", "gap_before": 0.4 },
    { "id": "s7", "text": "그렇게 여러 세포에 색소가 쌓여요.", "gap_before": 0.4 },
    { "id": "s8", "text": "그래서 피부가 그을리다가, 너무 심하면 화상이 돼요.", "gap_before": 0.6 }
  ]
}
