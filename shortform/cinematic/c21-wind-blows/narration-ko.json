{
  "segments": [
    { "id": "s1", "text": "굼구미가 바닷가에서 연을 날려요.", "gap_before": 1.2 },
    { "id": "s2", "text": "부채도 선풍기도 없는데 바람이 불어요.", "gap_before": 0.6 },
    { "id": "s3", "text": "근데 모래는 뜨겁고, 바다는 시원해요.", "gap_before": 0.5 },
    { "id": "s4", "text": "공기 속으로 확대해서 볼게요.", "gap_before": 0.6 },
    { "id": "s5", "text": "햇빛이 모래를 더 빨리 데워요.", "gap_before": 0.5 },
    { "id": "s6", "text": "그래서 모래 위 공기가 더 뜨거워져요.", "gap_before": 0.4 },
    { "id": "s7", "text": "뜨거워진 공기는 위로 떠올라요.", "gap_before": 0.4 },
    { "id": "s8", "text": "그 자리는 기압, 그러니까 공기가 미는 힘이 약해져요.", "gap_before": 0.4 },
    { "id": "s9", "text": "기압이 높은 곳에서 낮은 곳으로 공기가 흘러가요.", "gap_before": 0.4 },
    { "id": "s10", "text": "이렇게 움직이는 공기가 바로 바람이에요.", "gap_before": 0.4 },
    { "id": "s11", "text": "다시 바닷가를 보면 바다에서 모래 쪽으로 바람이 불어요.", "gap_before": 0.5 },
    { "id": "s12", "text": "땅이 다르게 데워지면서 생긴 압력 차이가 바람을 만들어요.", "gap_before": 0.5 }
  ]
}
