{
  "segments": [
    { "id": "s1", "text": "비 온 뒤 연잎 위의 물방울은 동글동글 굴러다녀요.", "gap_before": 1.0, "emph": ["동글동글", "굴러다녀요."] },
    { "id": "s2", "text": "잎이 매끈해서 미끄러지는 게 아니에요.", "gap_before": 0.7, "emph": ["아니에요."] },
    { "id": "s3", "text": "연잎 표면은 작은 돌기로 오돌토돌해요.", "gap_before": 0.8, "emph": ["돌기로", "오돌토돌해요."] },
    { "id": "s4", "text": "돌기 위 왁스는 물과 안 어울려 물끼리 뭉쳐요.", "gap_before": 0.8, "emph": ["어울려", "뭉쳐요."] },
    { "id": "s5", "text": "뭉친 물방울은 돌기 끝에만 얹히고 아래는 공기예요.", "gap_before": 0.8, "emph": ["끝에만", "공기예요."] },
    { "id": "s6", "text": "연잎은 매끈한 면보다 닿는 곳이 적어 덜 붙잡아요.", "gap_before": 0.8, "emph": ["적어", "덜"] },
    { "id": "s7", "text": "그래서 연잎 위 물방울은 살짝만 기울어도 굴러요.", "gap_before": 1.0, "emph": ["살짝만", "굴러요."] }
  ]
}
